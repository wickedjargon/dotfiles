#!/bin/sh
# Keep the system timezone in sync with the machine's physical location
# (like phones and macbooks do), based on IP geolocation.
#
# NetworkManager runs this as root on network events, so timedatectl needs
# no polkit/sudoers setup. The wall clock itself stays NTP-synced (UTC) by
# systemd-timesyncd regardless — only the timezone label is at stake here,
# so every failure path below is a silent "do nothing, retry on the next
# network event".
#
# VPN guard: if egress is routed through a tunnel device (mullvad, a
# tailscale exit node, any tun*/wg*), the public IP geolocates to the VPN
# country, so we skip. Tailscale without an exit node keeps the default
# route on the real uplink and is not skipped. Taking the VPN down fires a
# "down" event, so the timezone self-corrects on disconnect.

PATH=/usr/sbin:/usr/bin:/sbin:/bin

case "$2" in
    up|down|connectivity-change) ;;
    *) exit 0 ;;
esac

# Only act with full internet access (skips captive portals; once the portal
# is passed, NM fires a connectivity-change to FULL and we run again).
connectivity="${CONNECTIVITY_STATE:-$(nmcli networking connectivity 2>/dev/null)}"
case "$connectivity" in
    FULL|full) ;;
    *) exit 0 ;;
esac

# VPN guard: skip when the default egress route goes through a tunnel.
egress_dev=$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p')
[ -n "$egress_dev" ] || exit 0
case "$egress_dev" in
    mullvad|tailscale*|tun*|wg*|ppp*) exit 0 ;;
esac

# Ask several independent geolocation services and require corroboration —
# any single database can be wrong. (ipapi.co was dropped from this list: it
# geolocated TELUS BC ranges to America/Toronto while every other service
# correctly reported America/Vancouver.) The rule:
#   1. if two or more services agree on a zone, use it (strongest signal);
#   2. else (a service is down, or they disagree) use the first valid answer;
#   3. if nothing usable remains, do nothing and retry on the next event.
#
# Each entry is "url<space>parser": parser "-" means the response body is
# already the zone (plaintext); otherwise it names the JSON key holding the
# zone. HTTPS sources are listed first so a lone fallback prefers them
# (ip-api.com's free tier is HTTP-only).
SERVICES="https://ipinfo.io/timezone -
https://get.geojs.io/v1/ip/geo.json timezone
https://reallyfreegeoip.org/json/ time_zone
http://ip-api.com/line/?fields=timezone -"

# Pull a "key":"value" string out of a flat JSON body and unescape any \/.
json_field() {
    grep -oE "\"$1\"[[:space:]]*:[[:space:]]*\"[^\"]+\"" | head -1 |
        sed -E 's#.*:[[:space:]]*"##; s#"$##; s#\\/#/#g'
}

# Validate a candidate: must look like Area/City, carry no junk or path
# traversal, and name a real zoneinfo entry.
valid_zone() {
    case "$1" in
        */*) ;;
        *) return 1 ;;
    esac
    case "$1" in
        /*|*..*|*[!A-Za-z0-9/_+-]*) return 1 ;;
    esac
    [ -f "/usr/share/zoneinfo/$1" ]
}

votes=""        # newline-separated valid answers, duplicates kept for the vote
fallback=""     # first valid answer seen (used when no zone reaches a majority)
OIFS=$IFS
IFS='
'
for entry in $SERVICES; do
    url=${entry%% *}; parser=${entry##* }
    body=$(curl -sf --max-time 10 "$url") || continue
    if [ "$parser" = "-" ]; then
        ans=$(printf '%s' "$body" | tr -d '[:space:]')
    else
        ans=$(printf '%s' "$body" | json_field "$parser")
    fi
    valid_zone "$ans" || continue
    votes="$votes$ans
"
    [ -z "$fallback" ] && fallback=$ans
done
IFS=$OIFS

# Prefer a zone returned by two or more services; else the first valid answer;
# else give up until the next network event.
tz=""
for cand in $votes; do
    [ "$(printf '%s\n' "$votes" | grep -cxF "$cand")" -ge 2 ] && { tz=$cand; break; }
done
tz=${tz:-$fallback}
[ -n "$tz" ] || exit 0

current=$(timedatectl show -p Timezone --value 2>/dev/null)
[ "$tz" = "$current" ] && exit 0

timedatectl set-timezone "$tz" || exit 0
logger -t auto-timezone "timezone changed: ${current:-unknown} -> $tz"
