#!/usr/bin/env python3
"""dl — download video or audio into the ~/d/ library.

Downloads land in the same directories psync syncs to the phone:
video → ~/d/video, audio → ~/d/audio.

Requires: yt-dlp; ffmpeg (for audio extraction). On the Debian host
both are reached through the archbox container (shared $HOME means
downloads land in the same place).
"""

import os
import shlex
import subprocess
import sys
from shutil import which

# ── Colors ──────────────────────────────────────────────────────────
RED    = "\033[0;31m"
GREEN  = "\033[0;32m"
YELLOW = "\033[0;33m"
CYAN   = "\033[0;36m"
BOLD   = "\033[1m"
DIM    = "\033[2m"
RESET  = "\033[0m"


# ── Helpers ─────────────────────────────────────────────────────────
def info(msg):  print(f"{CYAN}▸{RESET} {msg}")
def ok(msg):    print(f"{GREEN}✓{RESET} {msg}")
def warn(msg):  print(f"{YELLOW}!{RESET} {msg}")
def die(msg):
    print(f"{RED}✗{RESET} {msg}", file=sys.stderr)
    sys.exit(1)


# ── Configuration ──────────────────────────────────────────────────
# Matches psync's directory map, so downloads are one `psync push` away
# from the phone.
VIDEO_DIR = os.path.expanduser("~/d/video")
AUDIO_DIR = os.path.expanduser("~/d/audio")
OUTPUT_TEMPLATE = "%(title).150s.%(ext)s"

ARCHBOX = "archbox"


def container_prefix():
    """Command prefix that reaches yt-dlp, or [] to run it directly.

    The Debian host keeps no yt-dlp (the packaged one goes stale), so
    from the host we run it inside the archbox container. Its $HOME is
    shared, so downloads land in the same ~/d/ directories. Inside a
    container, or when archbox isn't around, run directly.
    """
    if os.path.exists("/run/.containerenv") or not which("distrobox"):
        return []
    # Confirm the container exists first — `distrobox enter` on a
    # missing container prompts interactively to create it.
    result = subprocess.run(
        ["distrobox", "list", "--no-color"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        return []
    for line in result.stdout.splitlines():
        fields = [f.strip() for f in line.split("|")]
        if len(fields) > 1 and fields[1] == ARCHBOX:
            return ["distrobox", "enter", ARCHBOX, "--"]
    return []


def tool_available(prefix, tool):
    """Check for a tool where the download will actually run."""
    if not prefix:
        return which(tool) is not None
    result = subprocess.run(
        prefix + ["sh", "-c", f"command -v {tool}"],
        capture_output=True,
    )
    return result.returncode == 0


def build_command(urls, audio=False, paths_file=None):
    """Assemble the yt-dlp invocation for a batch of URLs."""
    target = AUDIO_DIR if audio else VIDEO_DIR
    cmd = [
        "yt-dlp",
        "--no-playlist",
        "-o", os.path.join(target, OUTPUT_TEMPLATE),
    ]
    if audio:
        # -x keeps the best audio stream in its native container.
        cmd.append("-x")
    if paths_file:
        # Record each final path (post-extraction for audio) so we can
        # print play hints — without capturing stdout, which would kill
        # the live progress bar.
        cmd += ["--print-to-file", "after_move:filepath", paths_file]
    cmd.extend(urls)
    return cmd


def validate_urls(urls):
    for url in urls:
        if not url.startswith(("http://", "https://")):
            die(f"Not a URL: {url}")


# ── Commands ────────────────────────────────────────────────────────
def do_download(urls, audio=False, prefix=()):
    validate_urls(urls)
    target = AUDIO_DIR if audio else VIDEO_DIR
    kind = "audio" if audio else "video"

    os.makedirs(target, exist_ok=True)
    via = f" {DIM}(via {ARCHBOX}){RESET}" if prefix else ""
    info(f"Downloading {kind} → {target}{via}")

    # Lives under $HOME so it's the same file inside archbox.
    paths_file = os.path.join(target, f".dl-paths-{os.getpid()}")
    try:
        # Run with inherited stdio so yt-dlp's progress bar shows live.
        result = subprocess.run(
            list(prefix) + build_command(urls, audio=audio, paths_file=paths_file)
        )
        if result.returncode != 0:
            die("yt-dlp reported errors")

        downloaded = []
        if os.path.exists(paths_file):
            with open(paths_file) as f:
                downloaded = [line.strip() for line in f if line.strip()]
    finally:
        if os.path.exists(paths_file):
            os.unlink(paths_file)

    ok(f"Done — saved under {target}")
    for path in downloaded:
        print(f"{DIM}Play with: mpv {shlex.quote(path)}{RESET}")
    print(f"{DIM}Send to the phone with: psync push --latest"
          f"{f' {len(urls)}' if len(urls) > 1 else ''}{RESET}")


# ── Help + Main ─────────────────────────────────────────────────────
HELP_TEXT = """\
usage: dl [audio] URL...

Download video or audio into the ~/d/ library (via yt-dlp).

commands:
  URL...                        download video(s) → ~/d/video
  audio URL...                  extract audio → ~/d/audio

Files land in the directories psync syncs, so `psync push --latest`
sends the download straight to the phone. Playlists are not expanded
(single video per URL).

examples:
  dl https://youtube.com/watch?v=xyz          video to ~/d/video
  dl audio https://youtube.com/watch?v=xyz    audio to ~/d/audio
  dl audio URL1 URL2                          several at once"""


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        sys.exit(0)

    prefix = container_prefix()
    where = f" (in {ARCHBOX})" if prefix else ""
    if not tool_available(prefix, "yt-dlp"):
        die(f"yt-dlp not installed{where}")

    args = sys.argv[1:]
    if args[0] == "audio":
        if not tool_available(prefix, "ffmpeg"):
            die(f"ffmpeg not installed{where} (needed for audio extraction)")
        if len(args) < 2:
            die("Usage: dl audio URL...")
        do_download(args[1:], audio=True, prefix=prefix)
    else:
        do_download(args, audio=False, prefix=prefix)


if __name__ == "__main__":
    main()
