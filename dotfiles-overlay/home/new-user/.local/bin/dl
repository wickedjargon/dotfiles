#!/usr/bin/env python3
"""dl — download video, audio, or files into the ~/d/ library.

Downloads land in the same directories psync syncs to the phone:
video → ~/d/video, audio → ~/d/audio, documents → ~/d/notes,
images → ~/d/images, archives → ~/d/other.

Media URLs go through yt-dlp; direct file URLs (recognized by
extension) are fetched with curl — no container needed.

Requires: yt-dlp; ffmpeg (for audio extraction); curl (for direct
files). On the Debian host yt-dlp is reached through the archbox
container (shared $HOME means downloads land in the same place).
"""

import os
import shlex
import subprocess
import sys
import urllib.parse
from shutil import which

# ── Colors ──────────────────────────────────────────────────────────
RED    = "\033[0;31m"
GREEN  = "\033[0;32m"
YELLOW = "\033[0;33m"
CYAN   = "\033[0;36m"
BOLD   = "\033[1m"
DIM    = "\033[2m"
RESET  = "\033[0m"


# ── Helpers ─────────────────────────────────────────────────────────
def info(msg):  print(f"{CYAN}▸{RESET} {msg}")
def ok(msg):    print(f"{GREEN}✓{RESET} {msg}")
def warn(msg):  print(f"{YELLOW}!{RESET} {msg}")
def die(msg):
    print(f"{RED}✗{RESET} {msg}", file=sys.stderr)
    sys.exit(1)


# ── Configuration ──────────────────────────────────────────────────
# Matches psync's directory map, so downloads are one `psync push` away
# from the phone.
VIDEO_DIR = os.path.expanduser("~/d/video")
AUDIO_DIR = os.path.expanduser("~/d/audio")
NOTES_DIR = os.path.expanduser("~/d/notes")
IMAGES_DIR = os.path.expanduser("~/d/images")
OTHER_DIR = os.path.expanduser("~/d/other")
OUTPUT_TEMPLATE = "%(title).150s.%(ext)s"

# Direct-download types: URL extension → target dir. Mirrors psync's
# classify_file() so every file lands where psync expects it. Media
# extensions stay with yt-dlp, and unknown extensions (.html, none)
# also go to yt-dlp in case the page holds a video.
DIRECT_DIRS = {}
for _ext in (".md", ".txt", ".pdf", ".epub", ".org", ".rst", ".doc",
             ".docx", ".odt", ".rtf", ".tex"):
    DIRECT_DIRS[_ext] = NOTES_DIR
for _ext in (".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".heif",
             ".bmp", ".tiff", ".tif", ".svg", ".avif"):
    DIRECT_DIRS[_ext] = IMAGES_DIR
for _ext in (".zip", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".7z", ".rar"):
    DIRECT_DIRS[_ext] = OTHER_DIR

ARCHBOX = "archbox"


def container_prefix():
    """Command prefix that reaches yt-dlp, or [] to run it directly.

    The Debian host keeps no yt-dlp (the packaged one goes stale), so
    from the host we run it inside the archbox container. Its $HOME is
    shared, so downloads land in the same ~/d/ directories. Inside a
    container, or when archbox isn't around, run directly.
    """
    if os.path.exists("/run/.containerenv") or not which("distrobox"):
        return []
    # Confirm the container exists first — `distrobox enter` on a
    # missing container prompts interactively to create it.
    result = subprocess.run(
        ["distrobox", "list", "--no-color"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        return []
    for line in result.stdout.splitlines():
        fields = [f.strip() for f in line.split("|")]
        if len(fields) > 1 and fields[1] == ARCHBOX:
            return ["distrobox", "enter", ARCHBOX, "--"]
    return []


def tool_available(prefix, tool):
    """Check for a tool where the download will actually run."""
    if not prefix:
        return which(tool) is not None
    result = subprocess.run(
        prefix + ["sh", "-c", f"command -v {tool}"],
        capture_output=True,
    )
    return result.returncode == 0


def build_command(urls, audio=False, paths_file=None):
    """Assemble the yt-dlp invocation for a batch of URLs."""
    target = AUDIO_DIR if audio else VIDEO_DIR
    cmd = [
        "yt-dlp",
        "--no-playlist",
        "-o", os.path.join(target, OUTPUT_TEMPLATE),
    ]
    if audio:
        # -x keeps the best audio stream in its native container.
        cmd.append("-x")
    if paths_file:
        # Record each final path (post-extraction for audio) so we can
        # print play hints — without capturing stdout, which would kill
        # the live progress bar.
        cmd += ["--print-to-file", "after_move:filepath", paths_file]
    cmd.extend(urls)
    return cmd


def validate_urls(urls):
    for url in urls:
        if not url.startswith(("http://", "https://")):
            die(f"Not a URL: {url}")


def direct_target(url):
    """Target dir for a direct file URL, or None to defer to yt-dlp."""
    ext = os.path.splitext(urllib.parse.urlparse(url).path)[1].lower()
    return DIRECT_DIRS.get(ext)


# ── Commands ────────────────────────────────────────────────────────
def do_fetch(urls):
    """Download direct file URLs with curl into their psync dirs."""
    if not which("curl"):
        die("curl not installed")
    for url in urls:
        target = direct_target(url)
        os.makedirs(target, exist_ok=True)
        name = os.path.basename(
            urllib.parse.unquote(urllib.parse.urlparse(url).path))
        path = os.path.join(target, name)
        base, ext = os.path.splitext(path)
        n = 1
        while os.path.exists(path):
            path = f"{base} ({n}){ext}"
            n += 1
        info(f"Downloading file → {path}")
        result = subprocess.run(
            ["curl", "-L", "--fail", "--remove-on-error", "-o", path, url])
        if result.returncode != 0:
            die("curl reported errors")
        ok(f"Saved {shlex.quote(path)}")


def do_download(urls, audio=False, prefix=()):
    target = AUDIO_DIR if audio else VIDEO_DIR
    kind = "audio" if audio else "video"

    os.makedirs(target, exist_ok=True)
    via = f" {DIM}(via {ARCHBOX}){RESET}" if prefix else ""
    info(f"Downloading {kind} → {target}{via}")

    # Lives under $HOME so it's the same file inside archbox.
    paths_file = os.path.join(target, f".dl-paths-{os.getpid()}")
    try:
        # Run with inherited stdio so yt-dlp's progress bar shows live.
        result = subprocess.run(
            list(prefix) + build_command(urls, audio=audio, paths_file=paths_file)
        )
        if result.returncode != 0:
            die("yt-dlp reported errors")

        downloaded = []
        if os.path.exists(paths_file):
            with open(paths_file) as f:
                downloaded = [line.strip() for line in f if line.strip()]
    finally:
        if os.path.exists(paths_file):
            os.unlink(paths_file)

    ok(f"Done — saved under {target}")
    for path in downloaded:
        print(f"{DIM}Play with: mpv {shlex.quote(path)}{RESET}")


# ── Help + Main ─────────────────────────────────────────────────────
HELP_TEXT = """\
usage: dl [audio] URL...

Download video, audio, or files into the ~/d/ library.

commands:
  URL...                        download video(s) → ~/d/video
  audio URL...                  extract audio → ~/d/audio

Direct file URLs are sorted by extension the way psync classifies
them: documents (pdf, epub, txt, ...) → ~/d/notes, images →
~/d/images, archives → ~/d/other. Everything else goes through
yt-dlp. Files land in the directories psync syncs, so `psync push
--latest` sends the download straight to the phone. Playlists are
not expanded (single video per URL).

Quote URLs containing ( ) & or spaces — the shell eats them bare.

examples:
  dl https://youtube.com/watch?v=xyz          video to ~/d/video
  dl audio https://youtube.com/watch?v=xyz    audio to ~/d/audio
  dl "https://example.com/report(1).pdf"      document to ~/d/notes
  dl audio URL1 URL2                          several at once"""


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        sys.exit(0)

    args = sys.argv[1:]
    audio = args[0] == "audio"
    if audio:
        args = args[1:]
        if not args:
            die("Usage: dl audio URL...")
    validate_urls(args)

    files = [u for u in args if direct_target(u)]
    media = [u for u in args if not direct_target(u)]
    if audio and files:
        die("audio mode takes video/audio URLs, not direct file links")

    if files:
        do_fetch(files)
    if media:
        prefix = container_prefix()
        where = f" (in {ARCHBOX})" if prefix else ""
        if not tool_available(prefix, "yt-dlp"):
            die(f"yt-dlp not installed{where}")
        if audio and not tool_available(prefix, "ffmpeg"):
            die(f"ffmpeg not installed{where} (needed for audio extraction)")
        do_download(media, audio=audio, prefix=prefix)

    print(f"{DIM}Send to the phone with: psync push --latest"
          f"{f' {len(args)}' if len(args) > 1 else ''}{RESET}")


if __name__ == "__main__":
    main()
