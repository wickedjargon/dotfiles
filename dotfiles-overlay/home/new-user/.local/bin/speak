#!/usr/bin/env python3
"""speak - Speak text aloud with edge-tts, or espeak-ng when offline.

Usage:
  speak                 Speak the current selection (the X PRIMARY selection,
                        or the CLIPBOARD when a clipboard-copying app like
                        zathura is focused).
  speak some words      Speak the given words.
  echo hi | speak -     Speak text read from stdin.

Options (for this run only):
  --voice NAME          Speak with a different voice, e.g. en-GB-RyanNeural.
  --rate RATE           Speak faster or slower, e.g. +25% or -10%.
  --engine NAME         Speak with a specific engine, skipping the automatic
                        choice: edge (online), kokoro, or espeak.
  -u, --unwrap          Undo PDF-style hard line wrapping before speaking, so
                        soft-wrapped lines don't cause pauses mid-sentence.
                        Real paragraph breaks are preserved. On by default.
  --no-unwrap           Keep line breaks as-is.

Settings (persisted in ~/.config/speak/config, used by every run,
including keybindings):
  --set KEY=VALUE       Save a setting and exit. Keys:
                          voice    voice name, e.g. en-GB-RyanNeural
                          rate     speech speed, e.g. +25% or -10%
                          unwrap   on|off (default: on)
                          offline  offline engine: espeak (default) or
                                   kokoro (natural; see kokoro --install)
  --show                Print the effective settings and their sources.
  --voices [FILTER]     List available voices, optionally filtered,
                        e.g. speak --voices en-GB

Bound to a key, pressing it again while speaking stops playback (toggle).
The voice and rate can also be overridden per-run with the SPEAK_VOICE and
SPEAK_RATE environment variables.

edge-tts (Microsoft's TTS) synthesizes the audio server-side, so it needs an
internet connection; without one, speak uses the configured offline engine:
espeak-ng by default, or Kokoro after `speak --set offline=kokoro`.
"""

import os
import re
import shlex
import signal
import socket
import subprocess
import sys
from pathlib import Path
from shutil import which

# If running inside a distrobox container, re-exec on the host so we reach the
# host's X selection and audio rather than the container's.
if os.path.exists("/run/.containerenv"):
    if which("distrobox-host-exec"):
        os.execvp("distrobox-host-exec", ["distrobox-host-exec"] + sys.argv)

# The re-exec lands here with host-spawn's minimal PATH (no ~/.local/bin),
# which would hide edge-tts. Make sure our own directory is searched.
_bindir = os.path.dirname(os.path.abspath(__file__))
if _bindir not in os.environ.get("PATH", "").split(os.pathsep):
    os.environ["PATH"] = _bindir + os.pathsep + os.environ.get("PATH", "")

CONFIG_FILE = (
    Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config")
    / "speak" / "config"
)
VOICES_CACHE = (
    Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache")
    / "speak" / "voices"
)

DEFAULTS = {"voice": "en-US-AvaNeural", "rate": "+0%", "unwrap": "on",
            "offline": "espeak"}
ENV_VARS = {"voice": "SPEAK_VOICE", "rate": "SPEAK_RATE"}

# Track the player so a second keypress can stop it.
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
PIDFILE = Path(RUNTIME) / "speak.pid"


def edge_tts_cmd():
    """How to invoke edge-tts: the CLI if present, else the module.

    Wiping ~/.local/bin deletes the pip/pipx launcher script but leaves
    the package in ~/.local/lib, so `python3 -m edge_tts` still works.
    Returns None when neither is available.
    """
    if which("edge-tts"):
        return ["edge-tts"]
    try:
        import edge_tts  # noqa: F401
    except ImportError:
        return None
    return [sys.executable, "-m", "edge_tts"]


def online(timeout=1.5):
    """Whether the edge-tts endpoint looks reachable (a cheap TCP connect)."""
    try:
        with socket.create_connection(
            ("speech.platform.bing.com", 443), timeout=timeout
        ):
            return True
    except OSError:
        return False


def espeak_voice(voice):
    """Map an edge-tts voice like en-US-AvaNeural to an espeak-ng voice."""
    m = re.match(r"([a-zA-Z]{2,3})-([a-zA-Z]{2})-", voice)
    return f"{m.group(1)}-{m.group(2)}".lower() if m else "en"


def espeak_speed(rate):
    """Map an edge-tts rate like +25% to espeak-ng's words per minute."""
    m = re.fullmatch(r"([+-]\d+)%", rate)
    pct = int(m.group(1)) if m else 0
    return str(max(80, round(175 * (1 + pct / 100))))


def kokoro_speed(rate):
    """Map an edge-tts rate like +25% to a playback factor like 1.25."""
    m = re.fullmatch(r"([+-]\d+)%", rate)
    pct = int(m.group(1)) if m else 0
    return f"{max(0.25, 1 + pct / 100):g}"


def kokoro_ready():
    """Whether the kokoro script and its model are installed and usable."""
    return which("kokoro") and subprocess.run(
        ["kokoro", "--ready"], capture_output=True,
    ).returncode == 0


def notify(msg, urgency="normal"):
    if which("notify-send"):
        subprocess.run(
            ["notify-send", "-u", urgency, "-a", "speak", "speak", msg],
            check=False,
        )
    else:
        print(f"speak: {msg}", file=sys.stderr)


# ── Settings ────────────────────────────────────────────────────────

def load_config():
    cfg = {}
    try:
        lines = CONFIG_FILE.read_text().splitlines()
    except FileNotFoundError:
        return cfg
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        cfg[key.strip()] = value.strip()
    return cfg


def effective_setting(key, cfg):
    """Resolve a setting and say where it came from: env > config > default."""
    env = ENV_VARS.get(key)
    if env and os.environ.get(env):
        return os.environ[env], "environment"
    if key in cfg:
        return cfg[key], "config"
    return DEFAULTS[key], "default"


def known_voices():
    """Voice short names, cached after the first fetch from edge-tts.

    Returns [] when the list can't be obtained (e.g. offline with no cache).
    """
    try:
        return VOICES_CACHE.read_text().split()
    except FileNotFoundError:
        pass
    cmd = edge_tts_cmd()
    if cmd is None:
        return []
    res = subprocess.run(
        cmd + ["--list-voices"], capture_output=True, text=True,
    )
    if res.returncode != 0:
        return []
    names = [
        line.split()[0]
        for line in res.stdout.splitlines()
        if line.split() and line.split()[0].endswith("Neural")
    ]
    if names:
        VOICES_CACHE.parent.mkdir(parents=True, exist_ok=True)
        VOICES_CACHE.write_text("\n".join(names) + "\n")
    return names


def validate_setting(key, value):
    """Return an error message, or None if the value is acceptable."""
    if key not in DEFAULTS:
        return f"unknown setting '{key}' (valid: {', '.join(sorted(DEFAULTS))})"
    if key == "unwrap" and value not in ("on", "off"):
        return "unwrap must be 'on' or 'off'"
    if key == "offline":
        if value not in ("espeak", "kokoro"):
            return "offline must be 'espeak' or 'kokoro'"
        if value == "kokoro" and not kokoro_ready():
            print("speak: warning: kokoro is not installed yet "
                  "(run: kokoro --install)", file=sys.stderr)
    if key == "rate" and not re.fullmatch(r"[+-]\d+%", value):
        return "rate must look like +25% or -10%"
    if key == "voice":
        voices = known_voices()
        if not voices:
            print(
                "speak: warning: could not fetch the voice list to verify "
                "the name (offline?)", file=sys.stderr,
            )
        elif value not in voices:
            return f"unknown voice '{value}' (see: speak --voices)"
    return None


def set_setting(assignment):
    key, sep, value = assignment.partition("=")
    key, value = key.strip(), value.strip()
    if not sep or not key or not value:
        print(f"speak: --set expects KEY=VALUE, got '{assignment}'",
              file=sys.stderr)
        sys.exit(2)
    err = validate_setting(key, value)
    if err:
        print(f"speak: {err}", file=sys.stderr)
        sys.exit(2)
    cfg = load_config()
    cfg[key] = value
    CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
    CONFIG_FILE.write_text("".join(f"{k}={v}\n" for k, v in sorted(cfg.items())))
    print(f"{key} = {value}")


def show_settings():
    cfg = load_config()
    for key in sorted(DEFAULTS):
        value, source = effective_setting(key, cfg)
        print(f"{key} = {value}  ({source})")


def list_voices(filters):
    voices = known_voices()
    if not voices:
        print("speak: could not fetch the voice list (offline?)",
              file=sys.stderr)
        sys.exit(1)
    for name in voices:
        if all(f.lower() in name.lower() for f in filters):
            print(name)


# ── Playback ────────────────────────────────────────────────────────

def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def stop_if_speaking():
    """Stop a still-running speak and return True; clean up stale pidfiles."""
    try:
        pid = int(PIDFILE.read_text().strip())
    except (FileNotFoundError, ValueError):
        return False
    speaking = alive(pid)
    if speaking:
        try:
            os.killpg(pid, signal.SIGTERM)  # kills the shell + edge-tts + mpv
        except ProcessLookupError:
            speaking = False
    PIDFILE.unlink(missing_ok=True)
    return speaking


def active_window_class():
    """Lower-cased WM_CLASS of the focused window, or "" if it can't be read."""
    if not (which("xdotool") and which("xprop")):
        return ""
    try:
        win = subprocess.run(
            ["xdotool", "getactivewindow"], capture_output=True, text=True,
        )
        wid = win.stdout.strip()
        if not wid:
            return ""
        res = subprocess.run(
            ["xprop", "-id", wid, "WM_CLASS"], capture_output=True, text=True,
        )
        return res.stdout.lower()
    except OSError:
        return ""


def unwrap_text(text):
    """Undo PDF-style hard line wrapping so TTS doesn't pause mid-sentence.

    PDFs end every visual line with a newline; edge-tts treats each as a clause
    break, so a single sentence is read in choppy fragments. Join soft-wrapped
    lines back into spaces while keeping real paragraph breaks (blank lines) as
    a single pause.
    """
    # Re-join words split across a line break: "exam-\nple" -> "example".
    text = re.sub(r"(\w)-\n(\w)", r"\1\2", text)
    # Protect paragraph breaks (a blank line) with a sentinel before unwrapping.
    para = "\x00"
    text = re.sub(r"\n[ \t]*\n+", para, text)
    # A lone newline within a paragraph is a soft wrap -> space.
    text = re.sub(r"\s*\n\s*", " ", text)
    # Restore paragraph breaks as real newlines (a natural TTS pause).
    text = text.replace(para, "\n")
    # Collapse runs of spaces/tabs left behind.
    text = re.sub(r"[ \t]+", " ", text)
    return text.strip()


def get_text(argv):
    if argv == ["-"]:
        return sys.stdin.read()
    if argv:
        return " ".join(argv)
    # No args: read the highlighted text. Most apps put it in the X PRIMARY
    # selection, but some copy the selection to the CLIPBOARD instead (e.g.
    # zathura with "set selection-clipboard clipboard"). PRIMARY is almost never
    # empty on a live session (it holds the last thing highlighted anywhere), so
    # we can't just fall back on emptiness -- we'd return stale PRIMARY and never
    # see the fresh CLIPBOARD text. Instead, when the focused window is one of
    # those clipboard-copying apps, try CLIPBOARD first.
    if not which("xclip"):
        notify("xclip not installed (needed to read the selection)", "critical")
        sys.exit(1)
    sels = ("primary", "clipboard")
    if "zathura" in active_window_class():
        sels = ("clipboard", "primary")
    for sel in sels:
        res = subprocess.run(
            ["xclip", "-selection", sel, "-o"],
            capture_output=True, text=True,
        )
        if res.stdout.strip():
            return res.stdout
    return ""


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return

    cfg = load_config()

    # Pull flags off the argument list; the rest is text to speak.
    unwrap_flag = None            # None = use the persisted setting
    voice = rate = engine = None  # one-shot overrides
    args = []
    i = 0

    def flag_value(name):
        nonlocal i
        i += 1
        if i >= len(argv):
            print(f"speak: {name} needs a value", file=sys.stderr)
            sys.exit(2)
        return argv[i]

    while i < len(argv):
        a = argv[i]
        if a in ("-u", "--unwrap"):
            unwrap_flag = True
        elif a == "--no-unwrap":
            unwrap_flag = False
        elif a == "--voice":
            voice = flag_value(a)
        elif a.startswith("--voice="):
            voice = a.partition("=")[2]
        elif a == "--rate":
            rate = flag_value(a)
        elif a.startswith("--rate="):
            rate = a.partition("=")[2]
        elif a == "--engine":
            engine = flag_value(a)
        elif a.startswith("--engine="):
            engine = a.partition("=")[2]
        elif a == "--set":
            set_setting(flag_value(a))
            return
        elif a.startswith("--set="):
            set_setting(a.partition("=")[2])
            return
        elif a == "--show":
            show_settings()
            return
        elif a == "--voices":
            list_voices(argv[i + 1:])
            return
        else:
            args.append(a)
        i += 1

    # Catch a typo'd one-shot voice/rate here rather than as silence later
    # (the edge-tts | mpv pipeline runs detached, so its errors are invisible).
    for key, value in (("voice", voice), ("rate", rate)):
        if value is not None:
            err = validate_setting(key, value)
            if err:
                print(f"speak: {err}", file=sys.stderr)
                sys.exit(2)
    if engine is not None and engine not in ("edge", "kokoro", "espeak"):
        print("speak: --engine must be 'edge', 'kokoro' or 'espeak'",
              file=sys.stderr)
        sys.exit(2)

    # Toggle: a bare keypress while talking just stops playback.
    was_speaking = stop_if_speaking()
    if was_speaking and not args:
        return

    # Pick the engine: edge-tts when its endpoint is reachable, else the
    # configured offline engine. No fallback chain beyond that -- if the
    # chosen engine is unusable, say so rather than silently degrade.
    # --engine skips the automatic choice for this run.
    edge = edge_tts_cmd()
    online_ready = edge is not None and which("mpv")
    auto = engine is None
    if auto:
        engine = ("edge" if online_ready and online()
                  else effective_setting("offline", cfg)[0])
    if engine == "edge":
        if not online_ready:
            notify("edge-tts or mpv not found", "critical")
            sys.exit(1)
    elif engine == "kokoro":
        if not kokoro_ready():
            notify("kokoro is not installed (run: kokoro --install)",
                   "critical")
            sys.exit(1)
    elif engine == "espeak":
        if not which("espeak-ng"):
            notify("espeak-ng not found in PATH", "critical")
            sys.exit(1)
    else:  # a hand-edited config can hold anything
        notify(f"unknown offline engine '{engine}' in config "
               "(use espeak or kokoro)", "critical")
        sys.exit(1)

    if voice is None:
        voice = effective_setting("voice", cfg)[0]
    if rate is None:
        rate = effective_setting("rate", cfg)[0]
    if unwrap_flag is None:
        unwrap_flag = effective_setting("unwrap", cfg)[0] == "on"

    text = get_text(args)
    if unwrap_flag:
        text = unwrap_text(text)
    text = text.strip()
    if not text:
        notify("Nothing selected to speak")
        return

    # The text is passed via the environment, not the command line, so a
    # selection containing quotes, $(...) or backticks can't break quoting
    # or inject shell commands.
    env = {**os.environ, "SPEAK_TEXT": text}
    if engine != "edge" and auto:
        why = "offline" if online_ready else "edge-tts/mpv unavailable"
        notify(f"{why} — speaking with "
               f"{'Kokoro' if engine == 'kokoro' else 'espeak-ng'}", "low")
    if engine == "edge":
        # Stream edge-tts' mp3 straight into mpv.
        env["SPEAK_VOICE"], env["SPEAK_RATE"] = voice, rate
        cmd = (f'{shlex.join(edge)} --voice "$SPEAK_VOICE" '
               '--rate="$SPEAK_RATE" --text "$SPEAK_TEXT" '
               '| mpv --no-terminal --really-quiet --no-video -')
    elif engine == "kokoro":
        env["SPEAK_RATE"] = kokoro_speed(rate)
        cmd = 'printf %s "$SPEAK_TEXT" | kokoro --speed "$SPEAK_RATE"'
    else:
        env["SPEAK_VOICE"] = espeak_voice(voice)
        env["SPEAK_RATE"] = espeak_speed(rate)
        cmd = ('printf %s "$SPEAK_TEXT" | '
               'espeak-ng --stdin -v "$SPEAK_VOICE" -s "$SPEAK_RATE"')
    proc = subprocess.Popen(
        cmd,
        shell=True, start_new_session=True, env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    PIDFILE.write_text(str(proc.pid))


if __name__ == "__main__":
    main(sys.argv[1:])
