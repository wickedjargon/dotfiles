#!/usr/bin/env python3
"""update — one view of everything updatable on this machine.

Covers apt, flatpak, firmware (fwupd), self-updating tools
(yt-dlp), and the archbox distrobox container. Strictly read-only:
it reports what is pending and prints the commands to apply the
updates, but never runs them itself.

Requires: apt; optional: flatpak, fwupdmgr, yt-dlp, distrobox
"""

import os
import re
import subprocess
import sys
import time
from shutil import which

# ── Colors ──────────────────────────────────────────────────────────
GREEN  = "\033[0;32m"
YELLOW = "\033[0;33m"
CYAN   = "\033[0;36m"
BOLD   = "\033[1m"
DIM    = "\033[2m"
RESET  = "\033[0m"


# ── Helpers ─────────────────────────────────────────────────────────
def run(cmd, timeout=60):
    """Run a command captured (for status checks)."""
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        return subprocess.CompletedProcess(cmd, 1, "", "Timed out")
    except FileNotFoundError:
        return subprocess.CompletedProcess(cmd, 1, "", "Command not found")


APT_LISTS = "/var/lib/apt/lists"


# ── Status Probes ──────────────────────────────────────────────────
def parse_apt_upgradable(text):
    """Count from `apt-get -s upgrade`: 'N upgraded, M newly installed...'"""
    m = re.search(r"^(\d+) upgraded, (\d+) newly installed", text,
                  re.MULTILINE)
    if not m:
        return None
    return int(m.group(1)) + int(m.group(2))


def apt_upgradable():
    result = run(["apt-get", "-s", "-o", "Debug::NoLocking=true",
                  "upgrade"], timeout=120)
    if result.returncode != 0:
        return None
    return parse_apt_upgradable(result.stdout)


def apt_lists_age_hours():
    """Hours since apt package lists were last refreshed, or None."""
    try:
        newest = max(
            os.path.getmtime(os.path.join(APT_LISTS, f))
            for f in os.listdir(APT_LISTS)
            if os.path.isfile(os.path.join(APT_LISTS, f)))
    except (OSError, ValueError):
        return None
    return (time.time() - newest) / 3600


def flatpak_updates():
    if not which("flatpak"):
        return None
    result = run(["flatpak", "remote-ls", "--updates"], timeout=60)
    if result.returncode != 0:
        return None
    return len([l for l in result.stdout.splitlines() if l.strip()])


def archbox_updates():
    if not which("distrobox"):
        return None
    result = run(["distrobox", "enter", "archbox", "--", "checkupdates"], timeout=60)
    if result.returncode == 2:
        return 0
    if result.returncode != 0:
        return None
    return len([l for l in result.stdout.splitlines() if l.strip()])


def firmware_updates():
    """Count of pending firmware updates, or None if unknowable."""
    if not which("fwupdmgr"):
        return None
    result = run(["fwupdmgr", "get-updates"], timeout=30)
    # Exit 2 with "No updates available" means clean; other failures
    # (no metadata, no daemon) are unknowable.
    if "No updates available" in result.stdout + result.stderr:
        return 0
    if result.returncode != 0:
        return None
    return len(re.findall(r"^│?[─└├\s]*New version:", result.stdout,
                          re.MULTILINE)) or 1


def _count_line(label, count, stale_note=""):
    if count is None:
        print(f"  {DIM}○{RESET} {label:<10} {DIM}unavailable{RESET}")
    elif count == 0:
        print(f"  {GREEN}●{RESET} {label:<10} up to date{stale_note}")
    else:
        print(f"  {YELLOW}●{RESET} {label:<10} {BOLD}{count}{RESET} "
              f"update{'s' if count != 1 else ''} pending{stale_note}")


UPDATE_COMMANDS = {
    "apt":      "sudo apt update && sudo apt full-upgrade",
    "flatpak":  "flatpak update",
    "firmware": "fwupdmgr refresh; fwupdmgr update",
    "archbox":  "distrobox enter archbox -- sudo pacman -Syu",
}


def cmd_status():
    """Show pending updates per source and how to apply them."""
    age = apt_lists_age_hours()
    lists_stale = age is None or age > 48
    if age is None:
        note = f"  {DIM}(lists never refreshed){RESET}"
    elif age > 48:
        note = f"  {YELLOW}(lists {age / 24:.0f}d old){RESET}"
    else:
        note = f"  {DIM}(lists {age:.0f}h old){RESET}"

    counts = {
        "apt":      apt_upgradable(),
        "flatpak":  flatpak_updates(),
        "firmware": firmware_updates(),
        "archbox":  archbox_updates(),
    }

    _count_line("apt", counts["apt"], note)
    _count_line("flatpak", counts["flatpak"])
    _count_line("firmware", counts["firmware"])
    _count_line("archbox", counts["archbox"])
    if which("yt-dlp"):
        print(f"  {DIM}○{RESET} {'yt-dlp':<10} "
              f"{DIM}check with: yt-dlp -U{RESET}")

    pending = [name for name, count in counts.items() if count]
    if lists_stale and "apt" not in pending:
        # Stale lists mean the apt count can't be trusted; refresh first.
        pending.insert(0, "apt")

    if pending:
        print()
        print("to update:")
        for name in pending:
            print(f"  {CYAN}{UPDATE_COMMANDS[name]}{RESET}")


# ── Help + Main ─────────────────────────────────────────────────────
HELP_TEXT = """\
usage: update

One view of everything updatable: apt, flatpak, firmware, archbox,
tools. Read-only — reports pending updates and prints the commands
to apply them, but never runs them itself."""


def main():
    if len(sys.argv) >= 2:
        if sys.argv[1] in ("-h", "--help", "help"):
            print(HELP_TEXT)
            sys.exit(0)
        print(f"Error: unexpected argument '{sys.argv[1]}'",
              file=sys.stderr)
        print("update takes no arguments; it only reports status.",
              file=sys.stderr)
        sys.exit(1)

    if not which("apt-get"):
        print("Error: apt not found (Debian-family only)",
              file=sys.stderr)
        sys.exit(1)

    cmd_status()


if __name__ == "__main__":
    main()
