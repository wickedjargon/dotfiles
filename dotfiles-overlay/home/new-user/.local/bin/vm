#!/usr/bin/env python3
"""vm — the full QEMU VM lifecycle from the command line.

Download an installer ISO, create a VM, run it, ssh in, and delete
it. Images live in ~/virtual-machines as <name>.<arch>.<RAM>.qcow2 —
the same convention create-qemu-vm writes and rofi-explorer (super+e)
launches, so VMs made here show up everywhere.

Requires: qemu-system-x86_64 / qemu-system-aarch64, curl (install)
"""

import hashlib
import json
import os
import re
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from shutil import which

# ── Colors ──────────────────────────────────────────────────────────
RED    = "\033[0;31m"
GREEN  = "\033[0;32m"
YELLOW = "\033[0;33m"
CYAN   = "\033[0;36m"
BOLD   = "\033[1m"
DIM    = "\033[2m"
RESET  = "\033[0m"


# ── Helpers ─────────────────────────────────────────────────────────
def info(msg):  print(f"{CYAN}▸{RESET} {msg}")
def ok(msg):    print(f"{GREEN}✓{RESET} {msg}")
def warn(msg):  print(f"{YELLOW}!{RESET} {msg}")
def die(msg):
    print(f"{RED}✗{RESET} {msg}", file=sys.stderr)
    sys.exit(1)


# ── Configuration ──────────────────────────────────────────────────
VM_DIR = os.path.expanduser("~/virtual-machines")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
# Same arch→ssh-port defaults create-qemu-vm uses.
DEFAULT_PORTS = {"x86_64": 2222, "aarch64": 2223}

FILENAME_RE = re.compile(
    r"^(?P<name>.+)\.(?P<arch>x86_64|aarch64)\.(?P<ram>\d+[GM]B?)\.qcow2$")


def parse_vm_filename(filename):
    """Parse the <name>.<arch>.<RAM>.qcow2 convention.

    RAM appears both as '2G' (create-qemu-vm) and '2GB' (older
    images); qemu only accepts the former, so normalize.
    """
    m = FILENAME_RE.match(filename)
    if not m:
        return None
    return {"name": m.group("name"), "arch": m.group("arch"),
            "ram": re.sub(r"B$", "", m.group("ram"))}


def state_path(name):
    return os.path.join(RUNTIME, f"vm-{name}.json")


def read_state(name):
    """{'pid', 'port', 'monitor'} for a VM we started, or None."""
    try:
        with open(state_path(name)) as f:
            state = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    try:
        os.kill(state["pid"], 0)
    except (ProcessLookupError, KeyError):
        try:
            os.unlink(state_path(name))
        except OSError:
            pass
        return None
    except PermissionError:
        pass
    return state


def qemu_pid_for(image_path):
    """Pid of a running qemu using this image (also finds externally
    started VMs, e.g. via dmenu-explorer)."""
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/cmdline", "rb") as f:
                cmdline = f.read().decode(errors="replace")
        except OSError:
            continue
        if "qemu-system" in cmdline and image_path in cmdline:
            return int(entry)
    return None


def get_vms():
    """All VMs with their parsed parameters and running state."""
    vms = []
    try:
        files = sorted(os.listdir(VM_DIR))
    except FileNotFoundError:
        return vms
    for filename in files:
        parsed = parse_vm_filename(filename)
        if not parsed:
            continue
        path = os.path.join(VM_DIR, filename)
        state = read_state(parsed["name"])
        pid = state["pid"] if state else qemu_pid_for(path)
        vms.append({
            **parsed,
            "path": path,
            "pid": pid,
            "port": (state or {}).get("port",
                                      DEFAULT_PORTS[parsed["arch"]]),
        })
    return vms


def resolve_vm(name=None, want_running=None):
    """Pick a VM by name, or auto-select the single candidate."""
    vms = get_vms()
    if want_running is True:
        candidates = [v for v in vms if v["pid"]]
    elif want_running is False:
        candidates = [v for v in vms if not v["pid"]]
    else:
        candidates = vms

    if name:
        for v in candidates:
            if v["name"] == name:
                return v
        die(f"No {'running ' if want_running else ''}VM named '{name}' "
            f"in {VM_DIR}")

    if not candidates:
        state = {True: "running", False: "stopped"}.get(want_running, "")
        die(f"No {state + ' ' if state else ''}VMs found in {VM_DIR}")
    if len(candidates) == 1:
        return candidates[0]

    print("Multiple VMs:", file=sys.stderr)
    for v in candidates:
        dot = f"{GREEN}●{RESET}" if v["pid"] else f"{DIM}○{RESET}"
        print(f"  {dot} {v['name']}  {DIM}{v['arch']} {v['ram']}{RESET}",
              file=sys.stderr)
    print(f"\nSpecify one, e.g.: vm start {candidates[0]['name']}",
          file=sys.stderr)
    sys.exit(1)


# ── Launch ──────────────────────────────────────────────────────────
def build_qemu_command(vm, port, monitor, headless=False):
    """qemu argv for booting an installed VM from its disk."""
    cmd = [f"qemu-system-{vm['arch']}", "-m", vm["ram"]]
    if vm["arch"] == "x86_64":
        if os.path.exists("/dev/kvm"):
            cmd.append("-enable-kvm")
        cmd += [
            "-drive", f"file={vm['path']},format=qcow2",
            "-netdev", f"user,id=net0,hostfwd=tcp::{port}-:22",
            "-device", "virtio-net-pci,netdev=net0",
            "-device", "intel-hda", "-device", "hda-output",
        ]
    else:  # aarch64, mirroring create-qemu-vm
        cmd += [
            "-machine", "virt", "-cpu", "cortex-a57",
            "-drive", f"file={vm['path']},format=qcow2,if=virtio",
            "-netdev", f"user,id=net0,hostfwd=tcp::{port}-:22",
            "-device", "virtio-net-pci,netdev=net0",
            "-bios", "/usr/share/qemu-efi-aarch64/QEMU_EFI.fd",
            "-device", "virtio-gpu-pci",
            "-device", "qemu-xhci",
            "-device", "usb-kbd", "-device", "usb-mouse",
        ]
    cmd += ["-monitor", f"unix:{monitor},server,nowait"]
    cmd += ["-display", "none" if headless else "gtk,zoom-to-fit=on"]
    return cmd


# ── ISO Catalog ─────────────────────────────────────────────────────
# create-qemu-vm boots the installer and writes the qcow2 with the
# filename convention above; `vm install` just gets it a fresh ISO.
CREATE_SCRIPT = os.path.expanduser("~/.local/scripts/create-qemu-vm")

DISTRO_HELP = {
    "debian": "netinst (x86_64, aarch64)",
    "arch":   "official iso (x86_64)",
    "alpine": "virt iso (x86_64, aarch64)",
    "ubuntu": "live server (x86_64)",
}


def fetch_text(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": "vm/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode(errors="replace")


def latest_match(text, pattern):
    """The highest-versioned filename matching `pattern` in a listing.

    `pattern` must capture the dotted version as group 1; returns the
    whole matched string, or None.
    """
    best = None
    best_ver = ()
    for m in re.finditer(pattern, text):
        ver = tuple(int(p) for p in m.group(1).split("."))
        if ver > best_ver:
            best_ver = ver
            best = m.group(0)
    return best


def resolve_iso(distro, arch):
    """Find the latest ISO for a distro: (iso_url, checksum_url).

    Dies for unknown distros or unsupported arches.
    """
    if distro == "debian":
        deb_arch = "amd64" if arch == "x86_64" else "arm64"
        base = (f"https://cdimage.debian.org/debian-cd/current/"
                f"{deb_arch}/iso-cd/")
        name = latest_match(
            fetch_text(base),
            rf"debian-(\d+\.\d+\.\d+)-{deb_arch}-netinst\.iso")
        if not name:
            die("Could not find the current Debian netinst ISO")
        return base + name, base + "SHA512SUMS"

    if distro == "arch":
        if arch != "x86_64":
            die("Arch ISOs are x86_64 only")
        base = "https://geo.mirror.pkgbuild.com/iso/latest/"
        return (base + "archlinux-x86_64.iso", base + "sha256sums.txt")

    if distro == "alpine":
        base = (f"https://dl-cdn.alpinelinux.org/alpine/latest-stable/"
                f"releases/{arch}/")
        name = latest_match(
            fetch_text(base),
            rf"alpine-virt-(\d+\.\d+\.\d+)-{arch}\.iso")
        if not name:
            die("Could not find the current Alpine virt ISO")
        return base + name, base + name + ".sha256"

    if distro == "ubuntu":
        if arch != "x86_64":
            die("Ubuntu ISOs here are x86_64 only")
        base = "https://releases.ubuntu.com/"
        listing = fetch_text(base)
        versions = sorted(
            {tuple(int(p) for p in v.split("."))
             for v in re.findall(r'href="(\d\d\.\d\d(?:\.\d+)?)/"',
                                 listing)},
            reverse=True)
        if not versions:
            die("Could not list Ubuntu releases")
        # The listing also shows unreleased versions (empty or missing
        # dirs) — walk newest-first until one actually has the ISO.
        for ver_tuple in versions:
            ver = ".".join(str(p) for p in ver_tuple)
            rel = f"{base}{ver}/"
            try:
                rel_listing = fetch_text(rel)
            except OSError:
                continue
            name = latest_match(
                rel_listing,
                r"ubuntu-(\d\d\.\d\d(?:\.\d+)?)-live-server-amd64\.iso")
            if name:
                return rel + name, rel + "SHA256SUMS"
        die("No Ubuntu live-server ISO found in any release directory")

    valid = ", ".join(sorted(DISTRO_HELP))
    die(f"Unknown distro '{distro}' (available: {valid})")


def checksum_from_text(text, filename):
    """Digest for `filename` from a SUMS-style file, or None.

    Handles 'digest  name' lines (Debian/Arch/Ubuntu) and bare-digest
    files (Alpine's per-ISO .sha256 also uses digest+name).
    """
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1].lstrip("*") == filename:
            return parts[0]
    # Single bare digest with no filename column
    stripped = text.strip()
    if re.fullmatch(r"[0-9a-fA-F]{64}|[0-9a-fA-F]{128}", stripped):
        return stripped
    return None


def file_digest(path, algo):
    h = hashlib.new(algo)
    with open(path, "rb") as f:
        while chunk := f.read(1024 * 1024):
            h.update(chunk)
    return h.hexdigest()


def verify_iso(path, checksum_url):
    """True if the file matches its published checksum."""
    try:
        text = fetch_text(checksum_url)
    except OSError:
        warn("Could not fetch the checksum file — skipping verification")
        return True
    digest = checksum_from_text(text, os.path.basename(path))
    if not digest:
        warn("ISO not listed in the checksum file — skipping verification")
        return True
    algo = "sha512" if len(digest) == 128 else "sha256"
    info(f"Verifying {algo} checksum...")
    return file_digest(path, algo) == digest.lower()


def download_iso(url, checksum_url):
    """Download (resumable) into /tmp and verify. Returns the path."""
    if not which("curl"):
        die("curl not installed (needed to download the ISO)")
    dest = os.path.join("/tmp", os.path.basename(url))

    if os.path.exists(dest) and verify_iso(dest, checksum_url):
        ok(f"Using already-downloaded {os.path.basename(dest)}")
        return dest

    info(f"Downloading {os.path.basename(url)}...")
    # -C - resumes a partial download; interactive so the bar shows.
    rc = subprocess.run(["curl", "-L", "-C", "-", "--fail",
                         "-o", dest, url]).returncode
    if rc != 0:
        die("Download failed")
    if not verify_iso(dest, checksum_url):
        os.unlink(dest)
        die("Checksum verification FAILED — corrupted or tampered "
            "download removed")
    ok("Checksum verified")
    return dest


def parse_create_opts(args):
    """Split install/create args into positionals and creation options."""
    opts = {"name": None, "ram": None, "disk": None, "arch": "x86_64"}
    positional = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--name", "--ram", "--disk", "--arch"):
            if i + 1 >= len(args):
                die(f"{a} needs a value")
            opts[a[2:]] = args[i + 1]
            i += 2
            continue
        positional.append(a)
        i += 1
    if opts["arch"] not in ("x86_64", "aarch64"):
        die("--arch must be x86_64 or aarch64")
    return positional, opts


def build_create_command(iso_path, opts):
    """argv for create-qemu-vm from parsed options."""
    script = which("create-qemu-vm") or CREATE_SCRIPT
    cmd = [script, iso_path, "--arch", opts["arch"]]
    if opts["name"]:
        cmd += ["--name", opts["name"]]
    if opts["ram"]:
        cmd += ["--ram", opts["ram"]]
    if opts["disk"]:
        cmd += ["--disk-size", opts["disk"]]
    return cmd


def _run_create(iso_path, opts):
    script = which("create-qemu-vm") or CREATE_SCRIPT
    if not os.path.exists(script):
        die("create-qemu-vm not found (expected in ~/.local/scripts)")
    info("Handing off to create-qemu-vm — the installer will boot "
         "in a QEMU window...")
    rc = subprocess.run(build_create_command(iso_path, opts)).returncode
    if rc != 0:
        die(f"create-qemu-vm exited with code {rc}")
    ok("VM created — it now shows up in `vm` and the super+e explorer")


# ── Commands ────────────────────────────────────────────────────────
def cmd_status():
    """List VMs and their state."""
    vms = get_vms()
    if not vms:
        print(f"{DIM}No VMs in {VM_DIR}.{RESET} "
              f"Create one with: create-qemu-vm")
        return
    width = max(len(v["name"]) for v in vms)
    for v in vms:
        size = os.path.getsize(v["path"])
        size_str = f"{size / 1024**3:.1f}G"
        if v["pid"]:
            print(f"  {GREEN}●{RESET} {BOLD}{v['name']:<{width}}{RESET}  "
                  f"{v['arch']}  {v['ram']}  {size_str}  "
                  f"{DIM}pid {v['pid']}, ssh -p {v['port']}{RESET}")
        else:
            print(f"  {DIM}○{RESET} {v['name']:<{width}}  "
                  f"{DIM}{v['arch']}  {v['ram']}  {size_str}{RESET}")


def cmd_start(args):
    """Boot a VM (detached)."""
    headless = "--headless" in args
    args = [a for a in args if a != "--headless"]
    name = args[0] if args else None
    port_override = int(args[1]) if len(args) > 1 and args[1].isdigit() \
        else None

    vm = resolve_vm(name, want_running=False)
    if not which(f"qemu-system-{vm['arch']}"):
        die(f"qemu-system-{vm['arch']} not installed")

    port = port_override or DEFAULT_PORTS[vm["arch"]]
    monitor = os.path.join(RUNTIME, f"vm-{vm['name']}.monitor")
    cmd = build_qemu_command(vm, port, monitor, headless=headless)

    mode = "headless" if headless else "with display"
    info(f"Starting {BOLD}{vm['name']}{RESET} ({vm['arch']}, {vm['ram']}, "
         f"{mode})...")
    proc = subprocess.Popen(
        cmd, start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(1)
    if proc.poll() is not None:
        die(f"QEMU exited immediately (code {proc.returncode}) — "
            f"port {port} may be in use")

    with open(state_path(vm["name"]), "w") as f:
        json.dump({"pid": proc.pid, "port": port, "monitor": monitor}, f)
    ok(f"{vm['name']} running  "
       f"{DIM}(ssh: vm ssh {vm['name']}, stop: vm stop {vm['name']}){RESET}")


def _monitor_powerdown(monitor):
    """Ask the guest to power down via the QEMU monitor socket."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(3)
        s.connect(monitor)
        s.recv(4096)  # banner
        s.sendall(b"system_powerdown\n")
        s.close()
        return True
    except OSError:
        return False


def cmd_stop(args):
    """Shut a VM down (ACPI powerdown, SIGTERM fallback)."""
    vm = resolve_vm(args[0] if args else None, want_running=True)
    state = read_state(vm["name"]) or {}
    monitor = state.get("monitor",
                        os.path.join(RUNTIME, f"vm-{vm['name']}.monitor"))

    info(f"Stopping {BOLD}{vm['name']}{RESET}...")
    if _monitor_powerdown(monitor):
        # Give the guest a chance to shut down cleanly.
        for _ in range(30):
            if not vm["pid"] or not _alive(vm["pid"]):
                break
            time.sleep(1)
    if vm["pid"] and _alive(vm["pid"]):
        warn("Guest didn't power down — terminating QEMU")
        try:
            os.kill(vm["pid"], signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    try:
        os.unlink(state_path(vm["name"]))
    except OSError:
        pass
    ok(f"{vm['name']} stopped")


def _alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def cmd_ssh(args):
    """ssh into a running VM through its forwarded port."""
    name = args[0] if args else None
    user = args[1] if len(args) > 1 else os.environ.get("USER", "root")
    vm = resolve_vm(name, want_running=True)
    os.execvp("ssh", ["ssh", "-p", str(vm["port"]),
                      f"{user}@localhost"])


def cmd_list():
    """Machine-parseable VM list."""
    for v in get_vms():
        state = "running" if v["pid"] else "stopped"
        print(f"{v['name']}\t{v['arch']}\t{v['ram']}\t{state}\t"
              f"{v['port']}\t{v['path']}")


def cmd_install(args):
    """Download a distro's latest ISO (verified) and create a VM."""
    positional, opts = parse_create_opts(args)
    if not positional:
        print(f"{BOLD}Available distros{RESET}")
        for name, desc in sorted(DISTRO_HELP.items()):
            print(f"  {name:<8} {DIM}{desc}{RESET}")
        print(f"\n{DIM}Usage: vm install <distro> [--name N] [--ram 2G] "
              f"[--disk 12G] [--arch aarch64]{RESET}")
        return
    distro = positional[0].lower()
    if not opts["name"]:
        opts["name"] = distro

    info(f"Resolving the latest {distro} ISO...")
    try:
        iso_url, checksum_url = resolve_iso(distro, opts["arch"])
    except OSError as e:
        die(f"Could not reach the {distro} mirror: {e}")

    iso_path = download_iso(iso_url, checksum_url)
    _run_create(iso_path, opts)


def cmd_create(args):
    """Create a VM from a local ISO (wraps create-qemu-vm)."""
    positional, opts = parse_create_opts(args)
    if not positional:
        die("Usage: vm create <file.iso> [--name N] [--ram 2G] "
            "[--disk 12G] [--arch aarch64]")
    iso_path = os.path.expanduser(positional[0])
    if not os.path.isfile(iso_path):
        die(f"ISO not found: {iso_path}")
    _run_create(iso_path, opts)


def cmd_delete(args):
    """Delete a VM's disk image (asks first)."""
    if not args:
        die("Usage: vm delete <name>")
    vm = resolve_vm(args[0])
    if vm["pid"]:
        die(f"{vm['name']} is running — stop it first: "
            f"vm stop {vm['name']}")
    size = os.path.getsize(vm["path"]) / 1024**3
    try:
        answer = input(f"{CYAN}▸{RESET} Permanently delete "
                       f"{BOLD}{vm['name']}{RESET} "
                       f"({os.path.basename(vm['path'])}, "
                       f"{size:.1f}G)? [y/N] ")
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if answer.strip().lower() not in ("y", "yes"):
        info("Nothing deleted")
        return
    os.unlink(vm["path"])
    try:
        os.unlink(state_path(vm["name"]))
    except OSError:
        pass
    ok(f"Deleted {vm['name']}")


# ── Help + Main ─────────────────────────────────────────────────────
HELP_TEXT = """\
usage: vm [command] [options]

The full QEMU VM lifecycle: download, install, run, ssh, delete.

commands:
  (none)                        list VMs and their state
  install [DISTRO] [opts]       download latest ISO (verified) + install
  create <ISO> [opts]           create a VM from a local ISO
  start [NAME] [PORT]           boot a VM (add --headless for no window)
  stop [NAME]                   ACPI powerdown, SIGTERM fallback
  ssh [NAME] [USER]             ssh via the forwarded port
  delete <NAME>                 delete the disk image (asks first)
  list                          machine-parseable VM list

install/create options: --name N  --ram 2G  --disk 12G  --arch aarch64
Distros: debian, arch, alpine, ubuntu (bare `vm install` lists them).

Images live in ~/virtual-machines as <name>.<arch>.<RAM>.qcow2 — the
same convention rofi-explorer (super+e) launches, so VMs made here
appear there too. ISO downloads are checksum-verified. SSH forwards
default to 2222 (x86_64) / 2223 (aarch64). NAME can be omitted when
only one VM qualifies.

examples:
  vm                            what VMs exist, what's running?
  vm install debian             fetch latest netinst, boot installer
  vm install alpine --ram 512M  small VM
  vm create ~/dl/custom.iso     install from a local ISO
  vm start                      boot the only VM
  vm start debian --headless    boot without a window
  vm ssh                        ssh into the running VM
  vm stop                       shut the running VM down
  vm delete debian              remove the disk image"""


def main():
    if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        sys.exit(0)

    if len(sys.argv) < 2:
        cmd_status()
        return

    command = sys.argv[1]
    args = sys.argv[2:]

    commands = {
        "install": lambda: cmd_install(args),
        "create":  lambda: cmd_create(args),
        "start":   lambda: cmd_start(args),
        "stop":    lambda: cmd_stop(args),
        "ssh":     lambda: cmd_ssh(args),
        "delete":  lambda: cmd_delete(args),
        "list":    lambda: cmd_list(),
    }

    if command not in commands:
        print(f"Error: unknown command '{command}'", file=sys.stderr)
        print("Run 'vm --help' for usage.", file=sys.stderr)
        sys.exit(1)

    commands[command]()


if __name__ == "__main__":
    main()
