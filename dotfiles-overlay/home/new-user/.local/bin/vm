#!/usr/bin/env python3
"""vm — the full QEMU VM lifecycle from the command line.

Download an installer ISO, create a VM, run it, ssh in, and delete
it. Images live in ~/virtual-machines as <name>.<arch>.<RAM>.qcow2 —
the same convention rofi-explorer (super+e) launches, so VMs made
here show up everywhere. Windows guests get UEFI, TPM 2.0 (Win11)
and in-box-driver devices automatically.

Requires: qemu-system-x86_64 / qemu-system-aarch64, qemu-img,
          curl (install), ovmf + swtpm (Windows guests)
"""

import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time
import urllib.request
from shutil import which

# ── Colors ──────────────────────────────────────────────────────────
RED    = "\033[0;31m"
GREEN  = "\033[0;32m"
YELLOW = "\033[0;33m"
CYAN   = "\033[0;36m"
BOLD   = "\033[1m"
DIM    = "\033[2m"
RESET  = "\033[0m"


# ── Helpers ─────────────────────────────────────────────────────────
def info(msg):  print(f"{CYAN}▸{RESET} {msg}")
def ok(msg):    print(f"{GREEN}✓{RESET} {msg}")
def warn(msg):  print(f"{YELLOW}!{RESET} {msg}")
def die(msg):
    print(f"{RED}✗{RESET} {msg}", file=sys.stderr)
    # GUI callers (xdg-open, rofi) have no terminal to show the error.
    if not sys.stderr.isatty() and which("notify-send"):
        subprocess.run(["notify-send", "-u", "critical", "vm", msg])
    sys.exit(1)


# ── Configuration ──────────────────────────────────────────────────
VM_DIR = os.path.expanduser("~/virtual-machines")
RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
# Same arch→ssh-port defaults create-qemu-vm uses.
DEFAULT_PORTS = {"x86_64": 2222, "aarch64": 2223}

FILENAME_RE = re.compile(
    r"^(?P<name>.+)\.(?P<arch>x86_64|aarch64)\.(?P<ram>\d+[GM]B?)\.qcow2$")

OVMF_DIR = "/usr/share/OVMF"

# ── OS Profiles ─────────────────────────────────────────────────────
# What `create` provisions and `start` boots per guest OS. Windows
# needs UEFI (plus TPM 2.0 and Secure Boot keys for 11) and devices
# it has in-box drivers for (SATA disk, e1000e NIC); Linux guests
# get virtio; macOS boots through OpenCore + AppleSMC with all disks
# on AHCI. `create` writes the chosen profile to a <image>.json
# sidecar so `start` applies it on every boot; no sidecar = linux.
OS_PROFILES = {
    "linux": {"uefi": False, "tpm": False, "secure": False,
              "ram": "1G", "disk": "12G", "cpus": 2},
    "win10": {"uefi": True,  "tpm": False, "secure": False,
              "ram": "4G", "disk": "64G", "cpus": 4},
    "win11": {"uefi": True,  "tpm": True,  "secure": True,
              "ram": "4G", "disk": "64G", "cpus": 4},
    "osx":   {"uefi": True,  "tpm": False, "secure": False,
              "ram": "4G", "disk": "128G", "cpus": 4},
}

# macOS refuses to boot without an AppleSMC exposing this key. The
# value is public knowledge (it surfaced in Apple v. Psystar) and is
# identical on every Mac ever made.
OSK = ("ourhardworkbythesewordsguardedpleasedontsteal"
       "(c)AppleComputerInc")

# qemu64 lacks features macOS requires; this Penryn + flags line is
# the OSX-KVM-proven combination.
OSX_CPU = ("Penryn,kvm=on,vendor=GenuineIntel,+invtsc,"
           "vmware-cpuid-freq=on,+ssse3,+sse4.2,+popcnt,+avx,+aes,"
           "+xsave,+xsaveopt,check")


def detect_os(iso_filename):
    """Guess the guest OS from an installer filename: 'win10',
    'win11', 'osx' or 'linux'."""
    name = iso_filename.lower()
    m = re.search(r"win(?:dows)?[-_ ]?(10|11)", name)
    if m:
        return "win" + m.group(1)
    if "windows" in name:
        return "win11"  # unversioned — assume the stricter profile
    if re.search(r"basesystem|mac[-_ ]?os|osx", name):
        return "osx"
    return "linux"


def profile_for(vm):
    return OS_PROFILES.get(vm.get("os"), OS_PROFILES["linux"])


def conf_path(image_path):
    return image_path + ".json"


def read_conf(image_path):
    """Per-VM overrides written by `create`: {'os', 'cpus'}."""
    try:
        with open(conf_path(image_path)) as f:
            conf = json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}
    os_name = conf.get("os")
    if os_name not in OS_PROFILES:
        os_name = "linux"
    return {"os": os_name,
            "cpus": int(conf.get("cpus",
                                 OS_PROFILES[os_name]["cpus"]))}


def parse_vm_filename(filename):
    """Parse the <name>.<arch>.<RAM>.qcow2 convention.

    RAM appears both as '2G' (create-qemu-vm) and '2GB' (older
    images); qemu only accepts the former, so normalize.
    """
    m = FILENAME_RE.match(filename)
    if not m:
        return None
    return {"name": m.group("name"), "arch": m.group("arch"),
            "ram": re.sub(r"B$", "", m.group("ram"))}


def state_path(name):
    return os.path.join(RUNTIME, f"vm-{name}.json")


def read_state(name):
    """{'pid', 'port', 'monitor'} for a VM we started, or None."""
    try:
        with open(state_path(name)) as f:
            state = json.load(f)
    except (OSError, json.JSONDecodeError):
        return None
    try:
        os.kill(state["pid"], 0)
    except (ProcessLookupError, KeyError):
        try:
            os.unlink(state_path(name))
        except OSError:
            pass
        return None
    except PermissionError:
        pass
    return state


def qemu_pid_for(image_path):
    """Pid of a running qemu using this image (also finds externally
    started VMs, e.g. via dmenu-explorer)."""
    for entry in os.listdir("/proc"):
        if not entry.isdigit():
            continue
        try:
            with open(f"/proc/{entry}/cmdline", "rb") as f:
                cmdline = f.read().decode(errors="replace")
        except OSError:
            continue
        if "qemu-system" in cmdline and image_path in cmdline:
            return int(entry)
    return None


def get_vms():
    """All VMs with their parsed parameters and running state."""
    vms = []
    try:
        files = sorted(os.listdir(VM_DIR))
    except FileNotFoundError:
        return vms
    for filename in files:
        parsed = parse_vm_filename(filename)
        if not parsed:
            continue
        path = os.path.join(VM_DIR, filename)
        state = read_state(parsed["name"])
        pid = state["pid"] if state else qemu_pid_for(path)
        vms.append({
            **parsed,
            **read_conf(path),
            "path": path,
            "pid": pid,
            "port": (state or {}).get("port",
                                      DEFAULT_PORTS[parsed["arch"]]),
        })
    return vms


def vm_from_path(path):
    """VM dict from an explicit path to a <name>.<arch>.<RAM>.qcow2."""
    path = os.path.abspath(os.path.expanduser(path))
    parsed = parse_vm_filename(os.path.basename(path))
    if not parsed:
        die(f"'{os.path.basename(path)}' doesn't match the "
            "<name>.<arch>.<RAM>.qcow2 convention")
    if not os.path.isfile(path):
        die(f"No such file: {path}")
    state = read_state(parsed["name"])
    pid = state["pid"] if state else qemu_pid_for(path)
    return {
        **parsed,
        **read_conf(path),
        "path": path,
        "pid": pid,
        "port": (state or {}).get("port", DEFAULT_PORTS[parsed["arch"]]),
    }


def resolve_vm(name=None, want_running=None):
    """Pick a VM by name or qcow2 path, or auto-select the single
    candidate."""
    # A path (xdg-open hands us one) works from any directory, not
    # just VM_DIR.
    if name and (os.sep in name or name.endswith(".qcow2")):
        vm = vm_from_path(name)
        if want_running is True and not vm["pid"]:
            die(f"VM '{vm['name']}' is not running")
        if want_running is False and vm["pid"]:
            die(f"VM '{vm['name']}' is already running")
        return vm

    vms = get_vms()
    if want_running is True:
        candidates = [v for v in vms if v["pid"]]
    elif want_running is False:
        candidates = [v for v in vms if not v["pid"]]
    else:
        candidates = vms

    if name:
        for v in candidates:
            if v["name"] == name:
                return v
        die(f"No {'running ' if want_running else ''}VM named '{name}' "
            f"in {VM_DIR}")

    if not candidates:
        state = {True: "running", False: "stopped"}.get(want_running, "")
        die(f"No {state + ' ' if state else ''}VMs found in {VM_DIR}")
    if len(candidates) == 1:
        return candidates[0]

    print("Multiple VMs:", file=sys.stderr)
    for v in candidates:
        dot = f"{GREEN}●{RESET}" if v["pid"] else f"{DIM}○{RESET}"
        print(f"  {dot} {v['name']}  {DIM}{v['arch']} {v['ram']}{RESET}",
              file=sys.stderr)
    print(f"\nSpecify one, e.g.: vm start {candidates[0]['name']}",
          file=sys.stderr)
    sys.exit(1)


# ── Launch ──────────────────────────────────────────────────────────
def ensure_uefi(vm):
    """Firmware for a UEFI guest: (code_path, per-VM vars copy, smm).

    The .ms build ships Microsoft's Secure Boot keys (Windows 11
    setup checks for them) and requires SMM; fall back to the plain
    build when it's absent. The vars store is copied next to the
    disk image so boot entries persist.
    """
    candidates = [(".fd", False)]
    if profile_for(vm)["secure"]:
        candidates.insert(0, (".ms.fd", True))
    for suffix, smm in candidates:
        code = os.path.join(OVMF_DIR, "OVMF_CODE_4M" + suffix)
        template = os.path.join(OVMF_DIR, "OVMF_VARS_4M" + suffix)
        if os.path.exists(code) and os.path.exists(template):
            break
    else:
        die("OVMF firmware not found — install it: sudo apt install ovmf")
    vars_path = vm["path"] + ".vars.fd"
    if not os.path.exists(vars_path):
        shutil.copyfile(template, vars_path)
    return code, vars_path, smm


def start_swtpm(vm):
    """Launch a TPM 2.0 emulator for this VM; returns its socket.

    TPM state lives next to the disk image so it survives reboots
    (BitLocker would otherwise lose its keys); swtpm exits together
    with QEMU (--terminate).
    """
    if not which("swtpm"):
        die("swtpm not installed (needed for a TPM 2.0 guest): "
            "sudo apt install swtpm")
    state_dir = vm["path"] + ".tpm"
    os.makedirs(state_dir, exist_ok=True)
    sock = os.path.join(RUNTIME, f"vm-{vm['name']}-tpm.sock")
    try:
        os.unlink(sock)
    except OSError:
        pass
    subprocess.Popen(
        ["swtpm", "socket", "--tpm2", "--terminate",
         "--tpmstate", f"dir={state_dir}",
         "--ctrl", f"type=unixio,path={sock}"],
        start_new_session=True)
    for _ in range(50):
        if os.path.exists(sock):
            return sock
        time.sleep(0.1)
    die("swtpm did not come up")


def build_qemu_command(vm, port, monitor, headless=False, iso=None,
                       uefi=None, tpm_sock=None):
    """qemu argv for a VM — booting from disk, or the installer when
    `iso` is given. `uefi` is ensure_uefi()'s triple, `tpm_sock`
    start_swtpm()'s socket."""
    profile = profile_for(vm)
    windows = vm.get("os", "linux").startswith("win")
    cmd = [f"qemu-system-{vm['arch']}", "-m", vm["ram"],
           "-smp", str(vm.get("cpus", profile["cpus"]))]
    osx = vm.get("os") == "osx"
    if vm["arch"] == "x86_64":
        if os.path.exists("/dev/kvm"):
            cmd += ["-enable-kvm"]
        if osx:
            cmd += ["-cpu", OSX_CPU]
        elif os.path.exists("/dev/kvm"):
            cmd += ["-cpu", "host"]
        if uefi:
            code, vars_path, smm = uefi
            cmd += ["-machine", "q35,smm=on" if smm else "q35"]
            if smm:
                cmd += ["-global",
                        "driver=cfi.pflash01,property=secure,value=on"]
            cmd += [
                "-drive", f"if=pflash,format=raw,readonly=on,file={code}",
                "-drive", f"if=pflash,format=raw,file={vars_path}",
            ]
        if osx:
            cmd += [
                "-device", f"isa-applesmc,osk={OSK}",
                "-smbios", "type=2",
                # macOS only drives AHCI here; OpenCore is the boot
                # disk, snapshot=on keeps it pristine.
                "-device", "ich9-ahci,id=sata",
                "-drive", ("id=OpenCoreBoot,if=none,snapshot=on,"
                           "format=qcow2,"
                           f"file={vm['path']}.opencore.qcow2"),
                "-device", "ide-hd,bus=sata.2,drive=OpenCoreBoot",
            ]
            basesystem = vm["path"] + ".basesystem.img"
            if os.path.exists(basesystem):
                # Staged by `create`; delete the sidecar once the
                # install is done.
                cmd += [
                    "-drive", ("id=InstallMedia,if=none,format=raw,"
                               f"file={basesystem}"),
                    "-device", "ide-hd,bus=sata.3,drive=InstallMedia",
                ]
            cmd += [
                "-drive", ("id=MacHDD,if=none,format=qcow2,"
                           f"file={vm['path']}"),
                "-device", "ide-hd,bus=sata.4,drive=MacHDD",
            ]
        else:
            # On q35 (Windows) the default bus is AHCI/SATA, which
            # Windows can drive without extra drivers.
            cmd += ["-drive", f"file={vm['path']},format=qcow2"]
        cmd += [
            "-netdev", f"user,id=net0,hostfwd=tcp::{port}-:22",
            "-device",
            ("e1000e" if windows else "virtio-net-pci") + ",netdev=net0",
        ]
        if osx:
            cmd += ["-device", "ich9-intel-hda", "-device", "hda-duplex"]
        else:
            cmd += ["-device", "intel-hda", "-device", "hda-output"]
        if windows or osx:
            cmd += ["-device", "qemu-xhci", "-device", "usb-tablet"]
        if osx:
            cmd += ["-device", "usb-kbd"]
    else:  # aarch64
        cmd += [
            "-machine", "virt", "-cpu", "cortex-a57",
            "-drive", f"file={vm['path']},format=qcow2,if=virtio",
            "-netdev", f"user,id=net0,hostfwd=tcp::{port}-:22",
            "-device", "virtio-net-pci,netdev=net0",
            "-bios", "/usr/share/qemu-efi-aarch64/QEMU_EFI.fd",
            "-device", "virtio-gpu-pci",
            "-device", "qemu-xhci",
            "-device", "usb-kbd", "-device", "usb-mouse",
        ]
    if tpm_sock:
        cmd += [
            "-chardev", f"socket,id=chrtpm,path={tpm_sock}",
            "-tpmdev", "emulator,id=tpm0,chardev=chrtpm",
            "-device", "tpm-tis,tpmdev=tpm0",
        ]
    if iso:
        cmd += ["-cdrom", iso]
        if not uefi:
            cmd += ["-boot", "d"]  # BIOS; OVMF boots the CD on its own
    if monitor:
        cmd += ["-monitor", f"unix:{monitor},server,nowait"]
    cmd += ["-display", "none" if headless else "gtk,zoom-to-fit=on"]
    return cmd


# ── ISO Catalog ─────────────────────────────────────────────────────
DISTRO_HELP = {
    "debian": "netinst (x86_64, aarch64)",
    "arch":   "official iso (x86_64)",
    "alpine": "virt iso (x86_64, aarch64)",
    "ubuntu": "live server (x86_64)",
    "win10":  "prints the ISO download URL (browser-gated)",
    "win11":  "prints the ISO download URL (browser-gated)",
}

# Microsoft gates ISO downloads behind a browser session, so
# `vm install win10/win11` can only point at the right page.
WINDOWS_ISO_PAGES = {
    "win10": "https://www.microsoft.com/software-download/windows10ISO",
    "win11": "https://www.microsoft.com/software-download/windows11",
}


def fetch_text(url, timeout=20):
    req = urllib.request.Request(url, headers={"User-Agent": "vm/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode(errors="replace")


def latest_match(text, pattern):
    """The highest-versioned filename matching `pattern` in a listing.

    `pattern` must capture the dotted version as group 1; returns the
    whole matched string, or None.
    """
    best = None
    best_ver = ()
    for m in re.finditer(pattern, text):
        ver = tuple(int(p) for p in m.group(1).split("."))
        if ver > best_ver:
            best_ver = ver
            best = m.group(0)
    return best


def resolve_iso(distro, arch):
    """Find the latest ISO for a distro: (iso_url, checksum_url).

    Dies for unknown distros or unsupported arches.
    """
    if distro == "debian":
        deb_arch = "amd64" if arch == "x86_64" else "arm64"
        base = (f"https://cdimage.debian.org/debian-cd/current/"
                f"{deb_arch}/iso-cd/")
        name = latest_match(
            fetch_text(base),
            rf"debian-(\d+\.\d+\.\d+)-{deb_arch}-netinst\.iso")
        if not name:
            die("Could not find the current Debian netinst ISO")
        return base + name, base + "SHA512SUMS"

    if distro == "arch":
        if arch != "x86_64":
            die("Arch ISOs are x86_64 only")
        base = "https://geo.mirror.pkgbuild.com/iso/latest/"
        return (base + "archlinux-x86_64.iso", base + "sha256sums.txt")

    if distro == "alpine":
        base = (f"https://dl-cdn.alpinelinux.org/alpine/latest-stable/"
                f"releases/{arch}/")
        name = latest_match(
            fetch_text(base),
            rf"alpine-virt-(\d+\.\d+\.\d+)-{arch}\.iso")
        if not name:
            die("Could not find the current Alpine virt ISO")
        return base + name, base + name + ".sha256"

    if distro == "ubuntu":
        if arch != "x86_64":
            die("Ubuntu ISOs here are x86_64 only")
        base = "https://releases.ubuntu.com/"
        listing = fetch_text(base)
        versions = sorted(
            {tuple(int(p) for p in v.split("."))
             for v in re.findall(r'href="(\d\d\.\d\d(?:\.\d+)?)/"',
                                 listing)},
            reverse=True)
        if not versions:
            die("Could not list Ubuntu releases")
        # The listing also shows unreleased versions (empty or missing
        # dirs) — walk newest-first until one actually has the ISO.
        for ver_tuple in versions:
            ver = ".".join(str(p) for p in ver_tuple)
            rel = f"{base}{ver}/"
            try:
                rel_listing = fetch_text(rel)
            except OSError:
                continue
            name = latest_match(
                rel_listing,
                r"ubuntu-(\d\d\.\d\d(?:\.\d+)?)-live-server-amd64\.iso")
            if name:
                return rel + name, rel + "SHA256SUMS"
        die("No Ubuntu live-server ISO found in any release directory")

    valid = ", ".join(sorted(DISTRO_HELP))
    die(f"Unknown distro '{distro}' (available: {valid})")


def checksum_from_text(text, filename):
    """Digest for `filename` from a SUMS-style file, or None.

    Handles 'digest  name' lines (Debian/Arch/Ubuntu) and bare-digest
    files (Alpine's per-ISO .sha256 also uses digest+name).
    """
    for line in text.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[-1].lstrip("*") == filename:
            return parts[0]
    # Single bare digest with no filename column
    stripped = text.strip()
    if re.fullmatch(r"[0-9a-fA-F]{64}|[0-9a-fA-F]{128}", stripped):
        return stripped
    return None


def file_digest(path, algo):
    h = hashlib.new(algo)
    with open(path, "rb") as f:
        while chunk := f.read(1024 * 1024):
            h.update(chunk)
    return h.hexdigest()


def verify_iso(path, checksum_url):
    """True if the file matches its published checksum."""
    try:
        text = fetch_text(checksum_url)
    except OSError:
        warn("Could not fetch the checksum file — skipping verification")
        return True
    digest = checksum_from_text(text, os.path.basename(path))
    if not digest:
        warn("ISO not listed in the checksum file — skipping verification")
        return True
    algo = "sha512" if len(digest) == 128 else "sha256"
    info(f"Verifying {algo} checksum...")
    return file_digest(path, algo) == digest.lower()


def download_iso(url, checksum_url):
    """Download (resumable) into /tmp and verify. Returns the path."""
    if not which("curl"):
        die("curl not installed (needed to download the ISO)")
    dest = os.path.join("/tmp", os.path.basename(url))

    if os.path.exists(dest) and verify_iso(dest, checksum_url):
        ok(f"Using already-downloaded {os.path.basename(dest)}")
        return dest

    info(f"Downloading {os.path.basename(url)}...")
    # -C - resumes a partial download; interactive so the bar shows.
    rc = subprocess.run(["curl", "-L", "-C", "-", "--fail",
                         "-o", dest, url]).returncode
    if rc != 0:
        die("Download failed")
    if not verify_iso(dest, checksum_url):
        os.unlink(dest)
        die("Checksum verification FAILED — corrupted or tampered "
            "download removed")
    ok("Checksum verified")
    return dest


def parse_create_opts(args):
    """Split install/create args into positionals and creation options."""
    opts = {"name": None, "ram": None, "disk": None, "arch": "x86_64",
            "os": None, "cpus": None}
    positional = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--name", "--ram", "--disk", "--arch", "--os", "--cpus"):
            if i + 1 >= len(args):
                die(f"{a} needs a value")
            opts[a[2:]] = args[i + 1]
            i += 2
            continue
        positional.append(a)
        i += 1
    if opts["arch"] not in ("x86_64", "aarch64"):
        die("--arch must be x86_64 or aarch64")
    if opts["os"]:
        opts["os"] = {"windows": "win11",
                      "macos": "osx"}.get(opts["os"], opts["os"])
        if opts["os"] not in OS_PROFILES:
            valid = ", ".join(sorted(OS_PROFILES))
            die(f"--os must be one of: {valid}")
    if opts["cpus"] and not str(opts["cpus"]).isdigit():
        die("--cpus must be a number")
    return positional, opts


def default_name(iso_path, os_name):
    """A VM name nobody typed: the OS for Windows, the leading word
    of the ISO for Linux ('debian-13.0-...' → 'debian')."""
    if os_name != "linux":
        return os_name
    m = re.match(r"[a-z]+", os.path.basename(iso_path).lower())
    return m.group(0) if m else "vm"


def find_opencore(installer_dir):
    """Locate an OpenCore boot image for a macOS guest: next to the
    recovery image, or in an OSX-KVM checkout there."""
    candidates = [
        os.path.join(installer_dir, "OpenCore.qcow2"),
        os.path.join(installer_dir, "OpenCore", "OpenCore.qcow2"),
    ]
    for c in candidates:
        if os.path.isfile(c):
            return c
    die("OpenCore.qcow2 not found (macOS needs its bootloader) — put "
        "it next to the recovery image; github.com/kholia/OSX-KVM "
        "ships it as OpenCore/OpenCore.qcow2")


def create_vm(iso_path, opts):
    """Provision a VM for an ISO and boot its installer (foreground)."""
    os_name = opts["os"] or detect_os(os.path.basename(iso_path))
    profile = OS_PROFILES[os_name]
    if os_name != "linux" and opts["arch"] != "x86_64":
        die(f"{os_name} guests are x86_64 only")
    if os_name.startswith("win") and not opts["os"]:
        extras = " + TPM 2.0 + Secure Boot" if profile["tpm"] else ""
        info(f"Windows ISO detected — using the {os_name} profile "
             f"(UEFI{extras}, SATA disk, e1000e NIC). "
             f"{DIM}Override with --os linux.{RESET}")
    opencore = None
    if os_name == "osx":
        if iso_path.lower().endswith(".dmg"):
            die("Convert the recovery image to raw first: "
                f"dmg2img -i {os.path.basename(iso_path)} BaseSystem.img")
        opencore = find_opencore(os.path.dirname(
            os.path.abspath(os.path.expanduser(iso_path))))
        if not opts["os"]:
            info("macOS recovery image detected — using the osx profile "
                 "(OpenCore + AppleSMC, AHCI disks). "
                 f"{DIM}Override with --os linux.{RESET}")

    name = opts["name"] or default_name(iso_path, os_name)
    arch = opts["arch"]
    ram = re.sub(r"B$", "", (opts["ram"] or profile["ram"]).upper())
    disk = opts["disk"] or profile["disk"]
    cpus = int(opts["cpus"] or profile["cpus"])

    for tool in ("qemu-img", f"qemu-system-{arch}"):
        if not which(tool):
            die(f"{tool} not installed")

    os.makedirs(VM_DIR, exist_ok=True)
    path = os.path.join(VM_DIR, f"{name}.{arch}.{ram}.qcow2")
    if os.path.exists(path):
        die(f"VM disk already exists: {path}")

    info(f"Creating {os.path.basename(path)} ({disk})...")
    rc = subprocess.run(["qemu-img", "create", "-f", "qcow2", path, disk],
                        stdout=subprocess.DEVNULL).returncode
    if rc != 0:
        die("qemu-img failed")

    vm = {"name": name, "arch": arch, "ram": ram, "path": path,
          "os": os_name, "cpus": cpus}
    if os_name != "linux" or opts["cpus"]:
        with open(conf_path(path), "w") as f:
            json.dump({"os": os_name, "cpus": cpus}, f)

    if os_name == "osx":
        # The recovery image rides along as a sidecar so `vm start`
        # keeps offering the installer across macOS's several install
        # reboots; delete it once the install is done.
        info("Staging OpenCore and the recovery image as sidecars...")
        shutil.copyfile(opencore, path + ".opencore.qcow2")
        shutil.copyfile(iso_path, path + ".basesystem.img")
        iso_path = None  # attached as an AHCI disk, not a cdrom

    uefi = ensure_uefi(vm) if profile["uefi"] else None
    tpm_sock = start_swtpm(vm) if profile["tpm"] else None

    info(f"Booting the installer ({os_name}, {ram}, {cpus} cpus) — "
         "Ctrl+Alt+G releases the mouse...")
    cmd = build_qemu_command(vm, DEFAULT_PORTS[arch], None, iso=iso_path,
                             uefi=uefi, tpm_sock=tpm_sock)
    rc = subprocess.run(cmd).returncode
    if rc not in (0, 1):  # 1 = window closed normally
        die(f"QEMU exited with code {rc} — clean up with: vm delete {name}")
    ok(f"{name} created — boot it with `vm start {name}`; it also "
       "shows up in `vm` and the super+e explorer")


# ── Commands ────────────────────────────────────────────────────────
def cmd_status():
    """List VMs and their state."""
    vms = get_vms()
    if not vms:
        print(f"{DIM}No VMs in {VM_DIR}.{RESET} "
              f"Create one with: vm install debian, or vm create <iso>")
        return
    width = max(len(v["name"]) for v in vms)
    for v in vms:
        size = os.path.getsize(v["path"])
        size_str = f"{size / 1024**3:.1f}G"
        os_tag = f"  {v['os']}" if v.get("os", "linux") != "linux" else ""
        if v["pid"]:
            print(f"  {GREEN}●{RESET} {BOLD}{v['name']:<{width}}{RESET}  "
                  f"{v['arch']}  {v['ram']}  {size_str}{os_tag}  "
                  f"{DIM}pid {v['pid']}, ssh -p {v['port']}{RESET}")
        else:
            print(f"  {DIM}○{RESET} {v['name']:<{width}}  "
                  f"{DIM}{v['arch']}  {v['ram']}  {size_str}{os_tag}{RESET}")


def cmd_start(args):
    """Boot a VM (detached)."""
    headless = "--headless" in args
    args = [a for a in args if a != "--headless"]
    name = args[0] if args else None
    port_override = int(args[1]) if len(args) > 1 and args[1].isdigit() \
        else None

    vm = resolve_vm(name, want_running=False)
    if not which(f"qemu-system-{vm['arch']}"):
        die(f"qemu-system-{vm['arch']} not installed")

    port = port_override or DEFAULT_PORTS[vm["arch"]]
    monitor = os.path.join(RUNTIME, f"vm-{vm['name']}.monitor")
    profile = profile_for(vm)
    uefi = ensure_uefi(vm) if profile["uefi"] else None
    tpm_sock = start_swtpm(vm) if profile["tpm"] else None
    cmd = build_qemu_command(vm, port, monitor, headless=headless,
                             uefi=uefi, tpm_sock=tpm_sock)

    mode = "headless" if headless else "with display"
    info(f"Starting {BOLD}{vm['name']}{RESET} ({vm['arch']}, {vm['ram']}, "
         f"{mode})...")
    proc = subprocess.Popen(
        cmd, start_new_session=True,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    time.sleep(1)
    if proc.poll() is not None:
        die(f"QEMU exited immediately (code {proc.returncode}) — "
            f"port {port} may be in use")

    with open(state_path(vm["name"]), "w") as f:
        json.dump({"pid": proc.pid, "port": port, "monitor": monitor}, f)
    ok(f"{vm['name']} running  "
       f"{DIM}(ssh: vm ssh {vm['name']}, stop: vm stop {vm['name']}){RESET}")


def _monitor_powerdown(monitor):
    """Ask the guest to power down via the QEMU monitor socket."""
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(3)
        s.connect(monitor)
        s.recv(4096)  # banner
        s.sendall(b"system_powerdown\n")
        s.close()
        return True
    except OSError:
        return False


def cmd_stop(args):
    """Shut a VM down (ACPI powerdown, SIGTERM fallback)."""
    vm = resolve_vm(args[0] if args else None, want_running=True)
    state = read_state(vm["name"]) or {}
    monitor = state.get("monitor",
                        os.path.join(RUNTIME, f"vm-{vm['name']}.monitor"))

    info(f"Stopping {BOLD}{vm['name']}{RESET}...")
    if _monitor_powerdown(monitor):
        # Give the guest a chance to shut down cleanly.
        for _ in range(30):
            if not vm["pid"] or not _alive(vm["pid"]):
                break
            time.sleep(1)
    if vm["pid"] and _alive(vm["pid"]):
        warn("Guest didn't power down — terminating QEMU")
        try:
            os.kill(vm["pid"], signal.SIGTERM)
        except (ProcessLookupError, PermissionError):
            pass
    try:
        os.unlink(state_path(vm["name"]))
    except OSError:
        pass
    ok(f"{vm['name']} stopped")


def _alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def cmd_ssh(args):
    """ssh into a running VM through its forwarded port."""
    name = args[0] if args else None
    user = args[1] if len(args) > 1 else os.environ.get("USER", "root")
    vm = resolve_vm(name, want_running=True)
    os.execvp("ssh", ["ssh", "-p", str(vm["port"]),
                      f"{user}@localhost"])


def cmd_list():
    """Machine-parseable VM list."""
    for v in get_vms():
        state = "running" if v["pid"] else "stopped"
        print(f"{v['name']}\t{v['arch']}\t{v['ram']}\t{state}\t"
              f"{v['port']}\t{v['path']}")


def cmd_install(args):
    """Download a distro's latest ISO (verified) and create a VM."""
    positional, opts = parse_create_opts(args)
    if not positional:
        print(f"{BOLD}Available targets{RESET}")
        for name, desc in sorted(DISTRO_HELP.items()):
            print(f"  {name:<8} {DIM}{desc}{RESET}")
        print(f"\n{DIM}Usage: vm install <distro> [--name N] [--ram 2G] "
              f"[--disk 12G] [--arch aarch64]{RESET}")
        return
    distro = positional[0].lower()
    distro = {"windows": "win11", "windows10": "win10",
              "windows11": "win11"}.get(distro, distro)
    if not opts["name"]:
        opts["name"] = distro

    if distro in WINDOWS_ISO_PAGES:
        info(f"Microsoft gates {distro} ISO downloads behind a browser "
             f"session — download it yourself from:")
        print(f"  {BOLD}{WINDOWS_ISO_PAGES[distro]}{RESET}")
        info("then create the VM from it: vm create <file.iso>")
        return

    info(f"Resolving the latest {distro} ISO...")
    try:
        iso_url, checksum_url = resolve_iso(distro, opts["arch"])
    except OSError as e:
        die(f"Could not reach the {distro} mirror: {e}")

    iso_path = download_iso(iso_url, checksum_url)
    create_vm(iso_path, opts)


def cmd_create(args):
    """Create a VM from a local ISO."""
    positional, opts = parse_create_opts(args)
    if not positional:
        die("Usage: vm create <file.iso|img> [--name N] [--os win11|osx] "
            "[--ram 4G] [--disk 64G] [--cpus 4] [--arch aarch64]")
    iso_path = os.path.expanduser(positional[0])
    if not os.path.isfile(iso_path):
        die(f"ISO not found: {iso_path}")
    create_vm(iso_path, opts)


def cmd_delete(args):
    """Delete a VM's disk image (asks first)."""
    if not args:
        die("Usage: vm delete <name>")
    vm = resolve_vm(args[0])
    if vm["pid"]:
        die(f"{vm['name']} is running — stop it first: "
            f"vm stop {vm['name']}")
    size = os.path.getsize(vm["path"]) / 1024**3
    try:
        answer = input(f"{CYAN}▸{RESET} Permanently delete "
                       f"{BOLD}{vm['name']}{RESET} "
                       f"({os.path.basename(vm['path'])}, "
                       f"{size:.1f}G)? [y/N] ")
    except (EOFError, KeyboardInterrupt):
        print()
        return
    if answer.strip().lower() not in ("y", "yes"):
        info("Nothing deleted")
        return
    os.unlink(vm["path"])
    # Sidecars: profile conf, UEFI vars store, OpenCore boot disk,
    # macOS recovery image, TPM state.
    for extra in (conf_path(vm["path"]), vm["path"] + ".vars.fd",
                  vm["path"] + ".opencore.qcow2",
                  vm["path"] + ".basesystem.img"):
        try:
            os.unlink(extra)
        except OSError:
            pass
    shutil.rmtree(vm["path"] + ".tpm", ignore_errors=True)
    try:
        os.unlink(state_path(vm["name"]))
    except OSError:
        pass
    ok(f"Deleted {vm['name']}")


def parse_resize_opts(args):
    """Split resize args into positionals and size options."""
    opts = {"ram": None, "disk": None, "cpus": None}
    positional = []
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--ram", "--disk", "--cpus"):
            if i + 1 >= len(args):
                die(f"{a} needs a value")
            opts[a[2:]] = args[i + 1]
            i += 2
            continue
        positional.append(a)
        i += 1
    if opts["cpus"] and not str(opts["cpus"]).isdigit():
        die("--cpus must be a number")
    return positional, opts


def cmd_resize(args):
    """Change a stopped VM's RAM, disk capacity or cpu count."""
    positional, opts = parse_resize_opts(args)
    if not any(opts.values()):
        die("Usage: vm resize [NAME] [--ram 8G] [--disk +40G] [--cpus 4]")
    vm = resolve_vm(positional[0] if positional else None)
    if vm["pid"]:
        die(f"{vm['name']} is running — stop it first: "
            f"vm stop {vm['name']}")

    if opts["ram"]:
        ram = re.sub(r"B$", "", opts["ram"].upper())
        if not re.fullmatch(r"\d+[GM]", ram):
            die("--ram must look like 8G or 512M")
        if ram == vm["ram"]:
            info(f"RAM is already {ram}")
        else:
            # RAM lives in the filename, so the image moves — and every
            # sidecar is keyed on the image name, so they move with it.
            old, new = vm["path"], os.path.join(
                os.path.dirname(vm["path"]),
                f"{vm['name']}.{vm['arch']}.{ram}.qcow2")
            if os.path.exists(new):
                die(f"Already exists: {new}")
            for suffix in ("", ".json", ".vars.fd", ".tpm",
                           ".opencore.qcow2", ".basesystem.img"):
                if os.path.exists(old + suffix):
                    os.rename(old + suffix, new + suffix)
            ok(f"RAM {vm['ram']} → {ram}  "
               f"{DIM}({os.path.basename(new)}){RESET}")
            vm["path"], vm["ram"] = new, ram

    if opts["disk"]:
        if not which("qemu-img"):
            die("qemu-img not installed")
        # No --shrink: qemu-img refuses to shrink, which is the point —
        # cutting a qcow2 short destroys guest filesystems.
        rc = subprocess.run(["qemu-img", "resize", vm["path"],
                             opts["disk"]],
                            stdout=subprocess.DEVNULL).returncode
        if rc != 0:
            die("qemu-img resize failed (shrinking is not supported)")
        ok(f"Disk resized ({opts['disk']})")
        info("Grow the partition inside the guest to use the new space "
             "(Windows: Disk Management, Linux: growpart/parted)")

    if opts["cpus"]:
        cpus = int(opts["cpus"])
        with open(conf_path(vm["path"]), "w") as f:
            json.dump({"os": vm.get("os", "linux"), "cpus": cpus}, f)
        ok(f"CPUs → {cpus}")


# ── Help + Main ─────────────────────────────────────────────────────
HELP_TEXT = """\
usage: vm [command] [options]

The full QEMU VM lifecycle: download, install, run, ssh, delete.

commands:
  (none)                        list VMs and their state
  install [DISTRO] [opts]       download latest ISO (verified) + install
  create <ISO> [opts]           create a VM from a local ISO
  start [NAME] [PORT]           boot a VM (add --headless for no window)
  stop [NAME]                   ACPI powerdown, SIGTERM fallback
  ssh [NAME] [USER]             ssh via the forwarded port
  resize [NAME] [opts]          change RAM, disk or cpus (stopped VM)
  delete <NAME>                 delete the disk image (asks first)
  list                          machine-parseable VM list

install/create options:
  --name N  --os win11|win10|osx|linux  --ram 2G  --disk 12G
  --cpus 4  --arch aarch64
Targets: debian, arch, alpine, ubuntu, win10, win11 (bare
`vm install` lists them). Windows ISOs can't be auto-downloaded
(Microsoft gates them) — `vm install win11` prints the download
URL; then `vm create` the downloaded ISO. Windows VMs get UEFI,
TPM 2.0 + Secure Boot (Win11), a SATA disk and an e1000e NIC, with
4G RAM / 64G disk / 4 cpus by default (needs the ovmf and swtpm
packages), all detected from the ISO's filename.

macOS guests (--os osx, detected from BaseSystem-style names) boot
through OpenCore + AppleSMC with all disks on AHCI; `create` stages
OpenCore.qcow2 (found next to the recovery image, e.g. in an
OSX-KVM checkout) and the recovery image itself as <image> sidecars
so the install survives reboots — delete <image>.basesystem.img
once macOS is installed. 4G RAM / 128G disk / 4 cpus by default.

resize options: --ram 8G  --disk +40G|100G  --cpus 4
RAM renames the image (and its sidecars — it's in the filename);
disk only grows (shrinking destroys guest filesystems) and the
partition must then be expanded inside the guest.

Images live in ~/virtual-machines as <name>.<arch>.<RAM>.qcow2 — the
same convention rofi-explorer (super+e) launches, so VMs made here
appear there too. Per-VM settings (OS profile, cpus) live in a
<image>.json sidecar that create writes and start applies. ISO
downloads are checksum-verified. SSH forwards default to 2222
(x86_64) / 2223 (aarch64). NAME can be omitted when only one VM
qualifies, or can be a path to a qcow2 file anywhere (this is what
xdg-open uses for application/x-qemu-disk).

examples:
  vm                            what VMs exist, what's running?
  vm install debian             fetch latest netinst, boot installer
  vm install alpine --ram 512M  small VM
  vm install win11              where to get the Windows ISO
  vm create ~/dl/custom.iso     install from a local ISO
  vm create Win11_24H2.iso      Windows 11 VM (UEFI + TPM, auto)
  vm create BaseSystem.img      macOS VM (OpenCore + AppleSMC, auto)
  vm start                      boot the only VM
  vm resize win11 --disk +40G   grow the disk (then extend in-guest)
  vm resize debian --ram 2G --cpus 4
  vm start debian --headless    boot without a window
  vm ssh                        ssh into the running VM
  vm stop                       shut the running VM down
  vm delete debian              remove the disk image"""


def main():
    if len(sys.argv) >= 2 and sys.argv[1] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        sys.exit(0)

    if len(sys.argv) < 2:
        cmd_status()
        return

    command = sys.argv[1]
    args = sys.argv[2:]

    commands = {
        "install": lambda: cmd_install(args),
        "create":  lambda: cmd_create(args),
        "start":   lambda: cmd_start(args),
        "stop":    lambda: cmd_stop(args),
        "ssh":     lambda: cmd_ssh(args),
        "resize":  lambda: cmd_resize(args),
        "delete":  lambda: cmd_delete(args),
        "list":    lambda: cmd_list(),
    }

    if command not in commands:
        print(f"Error: unknown command '{command}'", file=sys.stderr)
        print("Run 'vm --help' for usage.", file=sys.stderr)
        sys.exit(1)

    commands[command]()


if __name__ == "__main__":
    main()
