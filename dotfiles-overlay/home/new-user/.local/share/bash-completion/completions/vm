# bash completion for vm
_vm() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "install create start stop pause resume ssh resize delete list help --help" -- "$cur") )
        return
    fi

    local cmd="${COMP_WORDS[1]}"
    case "$prev" in
        --arch)
            COMPREPLY=( $(compgen -W "x86_64 aarch64" -- "$cur") )
            return
            ;;
        --os)
            COMPREPLY=( $(compgen -W "win10 win11 osx linux" -- "$cur") )
            return
            ;;
        --name|--ram|--disk|--cpus)
            return
            ;;
    esac
    case "$cmd" in
        install)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=( $(compgen -W "debian arch alpine ubuntu win10 win11 osx" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "--name --ram --disk --arch" -- "$cur") )
            fi
            ;;
        create)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=( $(compgen -f -X '!*.iso' -- "$cur") $(compgen -f -X '!*.img' -- "$cur") $(compgen -d -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "--name --os --ram --disk --cpus --arch" -- "$cur") )
            fi
            ;;
        start|stop|pause|resume|ssh|delete)
            if [ "$COMP_CWORD" -eq 2 ]; then
                local -a names
                mapfile -t names < <(ls -1 "$HOME/virtual-machines" 2>/dev/null | sed -n 's/\.\(x86_64\|aarch64\)\..*\.qcow2$//p')
                COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
            fi
            ;;
        resize)
            if [ "$COMP_CWORD" -eq 2 ]; then
                local -a names
                mapfile -t names < <(ls -1 "$HOME/virtual-machines" 2>/dev/null | sed -n 's/\.\(x86_64\|aarch64\)\..*\.qcow2$//p')
                COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
            else
                COMPREPLY=( $(compgen -W "--ram --disk --cpus" -- "$cur") )
            fi
            ;;
    esac
}

complete -o filenames -F _vm vm
