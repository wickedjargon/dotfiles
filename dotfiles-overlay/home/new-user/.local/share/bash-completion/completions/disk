# bash completion for disk
_disk() {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "big clean list help --help" -- "$cur") )
        return
    fi

    local cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        big)
            COMPREPLY=( $(compgen -d -- "$cur") )
            ;;
    esac
}

complete -o filenames -F _disk disk
