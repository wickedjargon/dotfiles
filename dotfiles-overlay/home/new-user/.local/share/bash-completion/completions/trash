# bash completion for trash
_trash() {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "list restore empty help --help" -- "$cur") $(compgen -f -- "$cur") )
        return
    fi

    local cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        restore)
            local -a names
            mapfile -t names < <(ls -1 "${XDG_DATA_HOME:-$HOME/.local/share}/Trash/files" 2>/dev/null)
            COMPREPLY=( $(compgen -W "${names[*]}" -- "$cur") )
            ;;
        list|empty)
            ;;
        *)
            COMPREPLY=( $(compgen -f -- "$cur") )
            ;;
    esac
}

complete -o filenames -F _trash trash
