# bash completion for kokoro
_kokoro() {
    local cur prev
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    local voices="af_alloy af_aoede af_bella af_heart af_jessica af_kore \
        af_nicole af_nova af_river af_sarah af_sky am_adam am_echo am_eric \
        am_fenrir am_liam am_michael am_onyx am_puck am_santa bf_alice \
        bf_emma bf_isabella bf_lily bm_daniel bm_fable bm_george bm_lewis"

    case "$prev" in
        --voice)
            COMPREPLY=( $(compgen -W "$voices" -- "$cur") )
            return
            ;;
        --speed)
            COMPREPLY=( $(compgen -W "0.75 1.0 1.1 1.25 1.5 2.0" -- "$cur") )
            return
            ;;
    esac

    # Positional arguments are free text to speak; only offer flags.
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "--install --ready --voices --voice \
            --speed --help" -- "$cur") )
    fi
}

complete -F _kokoro kokoro
