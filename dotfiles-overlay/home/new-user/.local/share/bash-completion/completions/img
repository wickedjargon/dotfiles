# bash completion for img
_img() {
    local cur
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "info exif resize rotate convert strip help --help" -- "$cur") )
        return
    fi

    local cmd="${COMP_WORDS[1]}"
    case "$cmd" in
        convert)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=( $(compgen -W "jpg png webp tiff avif" -- "$cur") )
                return
            fi
            ;;
        rotate)
            if [ "$COMP_CWORD" -eq 2 ]; then
                COMPREPLY=( $(compgen -W "90 180 270 -90 auto" -- "$cur") )
                return
            fi
            ;;
    esac
    # Fall through to filenames for FILE arguments
    COMPREPLY=( $(compgen -f -- "$cur") )
}

complete -o filenames -F _img img
